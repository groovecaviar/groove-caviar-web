+/* Boutons Groove Caviar — style unique réutilisable partout.
+   btn-gc        : base (forme, padding, typo)
+   btn-gc-primary: plein or (sur tout fond)
+   btn-gc-outline: contour clair (sur fond sombre, ex. Hero) */
+@utility btn-gc {
+  @apply inline-flex items-center justify-center gap-2 rounded-md px-8 py-3.5 text-sm font-semibold uppercase tracking-wider transition;
+}
+
+@utility btn-gc-primary {
+  @apply btn-gc bg-primary text-black hover:bg-secondary;
+}
+
+@utility btn-gc-outline {
+  @apply btn-gc border border-white/40 text-white hover:border-primary hover:text-primary;
+}
+
 .brand {
   text-transform: uppercase;
   letter-spacing: 0.01em;
