index 0000000..b062c1c
--- /dev/null
+++ b/src/components/gc/Header.astro
@@ -0,0 +1,368 @@
+---
+import logoUrl from '~/assets/images/logo-circulaire.svg?url';
+import { getLocale, useTranslations, getAlternateUrl } from '~/i18n/ui';
+
+const locale = getLocale(Astro.url);
+const t = useTranslations(locale);
+const p = (frVal: string, enVal: string) => (locale === 'fr' ? frVal : enVal);
+
+const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
+
+const nav = [
+  { label: t.nav.weddings, href: p('/mariages', '/en/weddings') },
+  { label: t.nav.parties, href: p('/soirees', '/en/parties') },
+  { label: t.nav.events, href: p('/evenements', '/en/events') },
+  { label: t.nav.music, href: p('/musique', '/en/music') },
+  { label: t.nav.about, href: p('/a-propos', '/en/about') },
+  { label: t.nav.contact, href: p('/contact', '/en/contact') },
+];
+
+const isActive = (href: string) => pathname === href.replace(/\/$/, '');
+
+const alt = getAlternateUrl(Astro.url.pathname, locale);
+const frUrl = locale === 'fr' ? Astro.url.pathname : (alt ?? '/');
+const enUrl = locale === 'en' ? Astro.url.pathname : (alt ?? '/en/');
+
+const homeHref = p('/', '/en/');
+const phoneHref = 'tel:+33623625704';
+---
+
+<header id="gc-header" class="gc-header">
+  <div class="gc-bar">
+    <!-- Logo + wordmark -->
+    <a href={homeHref} class="gc-brand" aria-label="Groove Caviar — accueil">
+      <img src={logoUrl} alt="" width="37" height="37" class="gc-logo" />
+      <span class="brand gc-wordmark">Groove Caviar</span>
+    </a>
+
+    <!-- Navigation desktop -->
+    <nav class="gc-nav">
+      {
+        nav.map((item) => (
+          <a href={item.href} class:list={['gc-navlink', isActive(item.href) && 'is-active']}>
+            {item.label}
+          </a>
+        ))
+      }
+    </nav>
+
+    <!-- Droite : langue + téléphone + burger -->
+    <div class="gc-actions">
+      <div class="gc-langgroup gc-langgroup--desktop">
+        <a href={frUrl} class:list={['gc-lang', locale === 'fr' && 'is-active']}>FR</a>
+        <span class="gc-langsep">/</span>
+        <a href={enUrl} class:list={['gc-lang', locale === 'en' && 'is-active']}>EN</a>
+      </div>
+
+      <a href={phoneHref} data-track="call-click" class="gc-cta gc-cta--desktop">
+        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="gc-icon" aria-hidden="true">
+          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2Z" />
+        </svg>
+        {t.cta.call}
+      </a>
+
+      <!-- Burger (mobile/tablette) -->
+      <button id="gc-burger" type="button" class="gc-burger" aria-label="Menu" aria-expanded="false" aria-controls="gc-mobile">
+        <span></span><span></span><span></span>
+      </button>
+    </div>
+  </div>
+
+  <!-- Menu mobile -->
+  <div id="gc-mobile" class="gc-mobile">
+    <nav class="gc-mobile-nav">
+      {
+        nav.map((item) => (
+          <a href={item.href} class:list={['gc-mobile-link', isActive(item.href) && 'is-active']}>
+            {item.label}
+          </a>
+        ))
+      }
+    </nav>
+    <div class="gc-mobile-foot">
+      <div class="gc-langgroup">
+        <a href={frUrl} class:list={['gc-lang', locale === 'fr' && 'is-active']}>FR</a>
+        <span class="gc-langsep">/</span>
+        <a href={enUrl} class:list={['gc-lang', locale === 'en' && 'is-active']}>EN</a>
+      </div>
+      <a href={phoneHref} data-track="call-click" class="gc-cta">
+        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="gc-icon" aria-hidden="true">
+          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2Z" />
+        </svg>
+        {t.cta.call}
+      </a>
+    </div>
+  </div>
+</header>
+
+<style>
+  /* ---------- Conteneur ---------- */
+  .gc-header {
+    position: fixed;
+    inset: 0 0 auto 0;
+    z-index: 50;
+    background-color: transparent;
+    transition: background-color 0.3s ease;
+  }
+  .gc-header.is-scrolled,
+  .gc-header.is-open {
+    background-color: #0d0d0d;
+    box-shadow: 0 1px 0 0 rgba(255, 255, 255, 0.06);
+  }
+
+  .gc-bar {
+    max-width: 80rem;
+    margin-inline: auto;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    padding: 0.75rem 1.25rem;
+  }
+  @media (min-width: 1024px) {
+    .gc-bar {
+      padding-inline: 2rem;
+    }
+  }
+
+  /* ---------- Logo + wordmark ---------- */
+  .gc-brand {
+    display: flex;
+    flex-shrink: 0;
+    align-items: center;
+    gap: 0.75rem;
+  }
+  .gc-logo {
+    width: 37px;
+    height: 37px;
+    flex-shrink: 0;
+  }
+  .gc-wordmark {
+    /* Couleur, graisse, capitales et letter-spacing viennent de la classe .brand */
+    font-family: var(--aw-font-heading, sans-serif);
+    line-height: 1;
+    white-space: nowrap;
+    font-size: clamp(1.4rem, 3.5vw, 1.6rem);
+  }
+
+  /* ---------- Navigation desktop ---------- */
+  .gc-nav {
+    display: none;
+    align-items: center;
+    gap: 1.5rem;
+  }
+  @media (min-width: 1024px) {
+    .gc-nav {
+      display: flex;
+    }
+  }
+  .gc-navlink {
+    position: relative;
+    display: inline-block;
+    text-align: center;
+    font-family: var(--aw-font-heading, sans-serif);
+    font-size: 0.82rem;
+    font-weight: 700;
+    line-height: 1.15;
+    text-transform: uppercase;
+    letter-spacing: 0.1em;
+    color: rgba(255, 255, 255, 0.85);
+    transition: color 0.2s ease;
+  }
+  .gc-navlink::after {
+    content: '';
+    position: absolute;
+    left: 0;
+    bottom: -7px;
+    width: 100%;
+    height: 1.5px;
+    background-color: #af9453;
+    transform: scaleX(0);
+    transform-origin: left;
+    transition: transform 0.25s ease;
+  }
+  .gc-navlink:hover {
+    color: #fff;
+  }
+  .gc-navlink:hover::after,
+  .gc-navlink.is-active::after {
+    transform: scaleX(1);
+  }
+  .gc-navlink.is-active {
+    color: #fff;
+  }
+
+  /* ---------- Bloc actions (droite) ---------- */
+  .gc-actions {
+    display: flex;
+    align-items: center;
+    gap: 1rem;
+  }
+
+  /* ---------- Sélecteur de langue ---------- */
+  .gc-langgroup {
+    display: flex;
+    align-items: center;
+    gap: 0.4rem;
+    font-size: 0.82rem;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: 0.08em;
+    line-height: 1;
+  }
+  .gc-langgroup--desktop {
+    display: none;
+  }
+  @media (min-width: 768px) {
+    .gc-langgroup--desktop {
+      display: flex;
+    }
+  }
+  .gc-langsep {
+    color: rgba(255, 255, 255, 0.3);
+  }
+  .gc-lang {
+    color: rgba(255, 255, 255, 0.5);
+    transition: color 0.2s ease;
+  }
+  .gc-lang:hover {
+    color: #fff;
+  }
+  .gc-lang.is-active {
+    color: #af9453;
+  }
+
+  /* ---------- Bouton téléphone ---------- */
+  .gc-cta {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.5rem;
+    border-radius: 6px;
+    background-color: #af9453;
+    color: #0d0d0d;
+    padding: 0.55rem 0.85rem;
+    font-size: 0.72rem;
+    font-weight: 600;
+    line-height: 1;
+    text-transform: uppercase;
+    letter-spacing: 0.07em;
+    white-space: nowrap;
+    transition: background-color 0.25s ease;
+  }
+  .gc-cta:hover {
+    background-color: #8a7440;
+  }
+  /* Variante en-tête : masquée sous le desktop (le menu mobile garde le sien). */
+  .gc-cta--desktop {
+    display: none;
+  }
+  @media (min-width: 1024px) {
+    .gc-cta--desktop {
+      display: inline-flex;
+    }
+  }
+  .gc-icon {
+    width: 1rem;
+    height: 1rem;
+  }
+
+  /* ---------- Burger (mobile/tablette) ---------- */
+  .gc-burger {
+    display: inline-flex;
+    flex-direction: column;
+    justify-content: center;
+    gap: 5px;
+    width: 30px;
+    height: 30px;
+    padding: 4px;
+  }
+  @media (min-width: 1024px) {
+    .gc-burger {
+      display: none;
+    }
+  }
+  .gc-burger span {
+    display: block;
+    height: 2px;
+    width: 100%;
+    background-color: #fff;
+    border-radius: 2px;
+    transition: transform 0.3s ease, opacity 0.2s ease;
+  }
+  .gc-burger.is-open span:nth-child(1) {
+    transform: translateY(7px) rotate(45deg);
+  }
+  .gc-burger.is-open span:nth-child(2) {
+    opacity: 0;
+  }
+  .gc-burger.is-open span:nth-child(3) {
+    transform: translateY(-7px) rotate(-45deg);
+  }
+
+  /* ---------- Panneau mobile ---------- */
+  .gc-mobile {
+    display: none;
+    background-color: #0d0d0d;
+    border-top: 1px solid rgba(255, 255, 255, 0.08);
+  }
+  .gc-mobile.is-open {
+    display: block;
+  }
+  @media (min-width: 1024px) {
+    .gc-mobile,
+    .gc-mobile.is-open {
+      display: none;
+    }
+  }
+  .gc-mobile-nav {
+    display: flex;
+    flex-direction: column;
+    gap: 0.25rem;
+    padding: 1.5rem;
+  }
+  .gc-mobile-link {
+    font-family: var(--aw-font-heading, sans-serif);
+    font-size: 1.1rem;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: 0.1em;
+    color: rgba(255, 255, 255, 0.9);
+    padding: 0.6rem 0;
+  }
+  .gc-mobile-link.is-active {
+    color: #af9453;
+  }
+  .gc-mobile-foot {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    border-top: 1px solid rgba(255, 255, 255, 0.1);
+    padding: 1.25rem 1.5rem;
+  }
+</style>
+
+<script>
+  const header = document.getElementById('gc-header');
+  const burger = document.getElementById('gc-burger');
+  const mobile = document.getElementById('gc-mobile');
+
+  const onScroll = () => {
+    if (!header) return;
+    header.classList.toggle('is-scrolled', window.scrollY > 20);
+  };
+  onScroll();
+  window.addEventListener('scroll', onScroll, { passive: true });
+
+  const toggleMenu = (open: boolean) => {
+    if (!burger || !mobile || !header) return;
+    burger.classList.toggle('is-open', open);
+    burger.setAttribute('aria-expanded', String(open));
+    header.classList.toggle('is-open', open);
+    mobile.classList.toggle('is-open', open);
+    document.body.style.overflow = open ? 'hidden' : '';
+  };
+  burger?.addEventListener('click', () => {
+    toggleMenu(burger.getAttribute('aria-expanded') !== 'true');
+  });
+  mobile?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => toggleMenu(false)));
+</script>
diff --git a/src/components/sections/EditorialStatement.astro b/src/components/sections/EditorialStatement.astro
new file mode 100644
index 0000000..98be800
--- /dev/null
+++ b/src/components/sections/EditorialStatement.astro
@@ -0,0 +1,105 @@
+---
+/**
+ * EditorialStatement — bloc éditorial premium (rupture visuelle façon campagne mode/luxe).
+ * Tailwind + Astro uniquement. Aucune dépendance JS. Responsive mobile-first.
+ * Couleurs Groove Caviar : or #AF9453 / noir #0D0D0D.
+ *
+ * Affiche : un titre accrocheur (avec mot/chiffre surligné en or via <mark>),
+ * un corps de direction artistique, et éventuellement une citation (Rock Salt).
+ */
+export interface Props {
+  eyebrow?: string; // petit label en capitales (optionnel)
+  headline?: string; // grand titre — accepte <mark>…</mark> pour le surlignage or
+  body?: string; // texte de direction artistique — accepte <br>, <strong>
+  quote?: string; // citation optionnelle
+  quoteAuthor?: string; // signature de la citation
+  theme?: 'light' | 'dark'; // fond clair (défaut) ou noir
+  align?: 'center' | 'left'; // centré (défaut) ou aligné à gauche
+}
+
+const { eyebrow, headline, body, quote, quoteAuthor, theme = 'light', align = 'center' } = Astro.props;
+
+const isDark = theme === 'dark';
+const isCenter = align === 'center';
+const muted = isDark ? 'text-white/70' : 'text-black/65';
+---
+
+<section
+  class:list={[
+    'editorial relative w-full overflow-hidden',
+    isDark ? 'bg-[#0D0D0D] text-white' : 'bg-[#F2F2F2] text-[#0D0D0D]',
+  ]}
+>
+  <div
+    class:list={[
+      'mx-auto flex max-w-4xl flex-col gap-10 px-6 py-28 sm:py-36 md:py-44',
+      isCenter ? 'items-center text-center' : 'items-start text-left',
+    ]}
+  >
+    {eyebrow && <span class="editorial-fade text-xs uppercase tracking-[0.35em] text-primary">{eyebrow}</span>}
+
+    {
+      headline && (
+        <h2
+          class="editorial-fade font-sans text-4xl font-bold leading-[1.12] tracking-tight sm:text-5xl md:text-6xl"
+          style="animation-delay:80ms"
+          set:html={headline}
+        />
+      )
+    }
+
+    {
+      body && (
+        <div
+          class:list={['editorial-fade max-w-2xl text-sm leading-relaxed sm:text-base', muted, isCenter && 'mx-auto']}
+          style="animation-delay:200ms"
+          set:html={body}
+        />
+      )
+    }
+
+    {
+      quote && (
+        <figure class="editorial-fade max-w-2xl" style="animation-delay:300ms">
+          <blockquote class="font-quote text-2xl font-bold text-primary sm:text-3xl">“{quote}”</blockquote>
+          {quoteAuthor && (
+            <figcaption class:list={['mt-4 text-xs uppercase tracking-[0.25em]', isDark ? 'text-white/40' : 'text-black/40']}>
+              {quoteAuthor}
+            </figcaption>
+          )}
+        </figure>
+      )
+    }
+  </div>
+</section>
+
+<style>
+  .editorial :global(mark) {
+    background-color: #af9453;
+    color: #0d0d0d;
+    padding: 0 0.2em;
+    border-radius: 2px;
+    box-decoration-break: clone;
+    -webkit-box-decoration-break: clone;
+  }
+  @keyframes editorial-rise {
+    from {
+      opacity: 0;
+      transform: translateY(18px);
+    }
+    to {
+      opacity: 1;
+      transform: translateY(0);
+    }
+  }
+  .editorial-fade {
+    opacity: 0;
+    animation: editorial-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .editorial-fade {
+      opacity: 1;
+      animation: none;
+    }
+  }
+</style>
diff --git a/src/components/sections/HeroHome.astro b/src/components/sections/HeroHome.astro
new file mode 100644
index 0000000..39149fb
--- /dev/null
+++ b/src/components/sections/HeroHome.astro
@@ -0,0 +1,89 @@
+---
+import { Image } from 'astro:assets';
+import heroImg from '~/assets/images/homepage-hero.webp';
+
+export interface Props {
+  titleLine1: string;
+  titleAccent: string; // ligne médiane, en or
+  titleLine3: string;
+  ctaQuote: { text: string; href: string; track: string };
+  ctaPhone: { text: string; href: string; type: 'tel' | 'whatsapp'; track: string };
+  socialProof: string;
+}
+
+const { titleLine1, titleAccent, titleLine3, ctaQuote, ctaPhone, socialProof } = Astro.props;
+const isWhatsApp = ctaPhone.type === 'whatsapp';
+---
+
+<section class="hero relative flex min-h-[100svh] w-full items-center justify-center overflow-hidden bg-black">
+  <Image
+    src={heroImg}
+    alt=""
+    widths={[768, 1280, 1920]}
+    sizes="100vw"
+    loading="eager"
+    fetchpriority="high"
+    class="hero-bg absolute inset-0 h-full w-full object-cover object-center"
+  />
+  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/35 to-black/60"></div>
+
+  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center px-6 text-center text-white">
+    <h1 class="font-heading leading-[1.05] tracking-tight">
+      <span class="block text-4xl font-bold uppercase sm:text-5xl md:text-6xl">{titleLine1}</span>
+      <span class="mt-2 block text-4xl font-semibold italic uppercase text-primary sm:text-5xl md:text-6xl">{titleAccent}</span>
+      <span class="mt-3 block font-quote text-2xl text-white/90 sm:text-3xl" set:html={titleLine3} />
+    </h1>
+
+    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
+      <a href={ctaQuote.href} data-track={ctaQuote.track} class="btn-gc-primary">
+        {ctaQuote.text}
+      </a>
+      <a
+        href={ctaPhone.href}
+        data-track={ctaPhone.track}
+        target={isWhatsApp ? '_blank' : undefined}
+        rel={isWhatsApp ? 'noopener noreferrer' : undefined}
+        class="btn-gc-outline"
+      >
+        {
+          isWhatsApp ? (
+            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
+              <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm5.78 14.06c-.24.68-1.4 1.3-1.93 1.34-.5.04-.97.22-3.26-.68-2.76-1.09-4.5-3.92-4.64-4.1-.13-.18-1.1-1.47-1.1-2.8 0-1.33.7-1.98.94-2.25.25-.27.54-.34.72-.34.18 0 .36 0 .52.01.17.01.39-.06.61.47.24.56.8 1.94.87 2.08.07.14.12.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.53 1.9 1.05.93 1.94 1.22 2.21 1.36.27.14.43.12.59-.07.16-.18.68-.79.86-1.06.18-.27.36-.22.61-.13.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.12.07.68-.17 1.36Z" />
+            </svg>
+          ) : (
+            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
+              <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2Z" />
+            </svg>
+          )
+        }
+        {ctaPhone.text}
+      </a>
+    </div>
+
+    <p class="mt-9 text-[0.7rem] uppercase tracking-[0.25em] text-white/70 sm:text-xs">{socialProof}</p>
+  </div>
+</section>
+
+<style>
+  /* Sur écran tactile (pas de survol) : image en couleur par défaut. */
+  .hero-bg {
+    filter: grayscale(0) brightness(1.18);
+    transition: filter 0.8s ease;
+    will-change: filter;
+  }
+  /* Sur appareils avec souris : N&B par défaut, couleur au survol du Hero
+     (revient en N&B dès que la souris quitte la zone, y compris au scroll). */
+  @media (hover: hover) {
+    .hero-bg {
+      filter: grayscale(1) brightness(1.18);
+    }
+    .hero:hover .hero-bg {
+      filter: grayscale(0) brightness(1.18);
+    }
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .hero-bg {
+      transition: none;
+    }
+  }
+</style>
diff --git a/src/components/sections/HomeSections.astro b/src/components/sections/HomeSections.astro
new file mode 100644
index 0000000..bc80876
--- /dev/null
+++ b/src/components/sections/HomeSections.astro
@@ -0,0 +1,21 @@
+---
