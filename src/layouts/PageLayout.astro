---
import Layout from '~/layouts/Layout.astro';
import GCHeader from '~/components/gc/Header.astro';
import GCFooter from '~/components/gc/Footer.astro';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: string;
}

const { metadata, lang } = Astro.props;
---

<Layout metadata={metadata} lang={lang}>
  <slot name="header">
    <GCHeader />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <GCFooter />
  </slot>
</Layout>
