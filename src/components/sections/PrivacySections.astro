---
import type { PrivacyContent } from '~/data/pages/privacy';

export interface Props {
  t: PrivacyContent;
  locale: 'fr' | 'en';
}

const { t } = Astro.props;

// Colle les guillemets français à leur contenu (jamais séparés en fin de ligne)
const nbsp = (s: string) => s.replace(/«\s+/g, '« ').replace(/\s+»/g, ' »');
---

<!-- ═══ BANDEAU TITRE ══════════════════════════════════════════════════════ -->
<section class="gc-legal-hero">
  <div class="gc-legal-hero-inner">
    <span class="gc-legal-eyebrow">{t.eyebrow}</span>
    <h1 class="gc-legal-h1">{t.title}</h1>
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ CONTENU ════════════════════════════════════════════════════════════ -->
<section class="gc-legal">
  <div class="gc-legal-inner">
    <p class="gc-legal-updated" set:html={t.updated} />
    {t.sections.map((s, i) => (
      <article class="gc-legal-section">
        <h2 class="gc-legal-title">
          <span class="gc-legal-num">{String(i + 1).padStart(2, '0')}</span>
          {s.title}
        </h2>
        <div class="gc-legal-body" set:html={nbsp(s.html)} />
      </article>
    ))}
  </div>
</section>

<style>
  /* Couleurs via les variables de palette (voir tailwind.css) */

  /* ── Bandeau titre (sous le header noir fixe) ────────────────────────── */
  .gc-legal-hero {
    background-color: var(--gc-ink);
    text-align: center;
    padding: 9rem 1.5rem 4.5rem;
  }
  .gc-legal-hero-inner {
    max-width: 48rem;
    margin-inline: auto;
  }
  .gc-legal-eyebrow {
    display: block;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--gc-gold);
    margin-bottom: 1.5rem;
  }
  .gc-legal-h1 {
    margin: 0;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.7rem, 4.5vw, 2.8rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: #FFFFFF;
  }
  .gc-legal-hero-inner :global(.gc-editorial-line) {
    margin-top: 1.75rem;
  }

  /* ── Contenu ─────────────────────────────────────────────────────────── */
  .gc-legal {
    background-color: var(--gc-surface);
    color: var(--gc-ink);
    padding: clamp(3rem, 8vh, 5rem) 1.25rem clamp(4rem, 10vh, 6rem);
  }
  .gc-legal-inner {
    max-width: 48rem;
    margin-inline: auto;
  }
  .gc-legal-updated {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--gc-ink);
    opacity: 0.7;
    margin-bottom: 3rem;
  }
  .gc-legal-section {
    padding-top: 2.25rem;
    margin-top: 2.25rem;
    border-top: 1px solid var(--gc-surface-alt);
  }
  .gc-legal-section:first-of-type {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }
  .gc-legal-title {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.25;
    color: var(--gc-ink);
    margin-bottom: 1.1rem;
  }
  .gc-legal-num {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--gc-gold);
    flex-shrink: 0;
  }
  .gc-legal-body {
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .gc-legal-body :global(p) { margin-bottom: 1rem; }
  .gc-legal-body :global(p:last-child) { margin-bottom: 0; }
  .gc-legal-body :global(strong) { font-weight: 700; }
  .gc-legal-body :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .gc-legal-body :global(ul:last-child) { margin-bottom: 0; }
  .gc-legal-body :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }
  .gc-legal-body :global(li)::before {
    content: '▶';
    position: absolute;
    left: 0;
    top: 0.1em;
    font-size: 0.55em;
    line-height: 2;
    color: var(--gc-gold);
  }
  .gc-legal-body :global(a) {
    color: var(--gc-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .gc-legal-body :global(a:hover) { color: var(--gc-ink); }

</style>
