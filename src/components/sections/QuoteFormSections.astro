---
// Page « Demande de devis » — formulaire multi-étapes piloté par les données de
// ~/data/pages/devis.ts. Utilisé par les 4 pages : /devis/mariages, /devis/booking-dj
// et leurs équivalents /en/quote/wedding, /en/quote/dj-booking.
// Envoi : POST JSON vers le script Google (voir ~/config/quote.ts et ~/Groove Caviar/Claude/devis-automation/).
import type { QuoteForm, QuoteUi, Opt } from '~/data/pages/devis';
import { QUOTE_ENDPOINT, QUOTE_CONTACT } from '~/config/quote';

export interface Props {
  t: QuoteForm;
  ui: QuoteUi;
  locale: 'fr' | 'en';
}

const { t, ui, locale } = Astro.props;

const norm = (o: Opt) => (typeof o === 'string' ? { value: o, label: o } : o);
const pad = (n: number) => String(n).padStart(2, '0');

// Horaires par pas de 30 minutes (00:00 → 23:30)
const times: string[] = [];
for (let h = 0; h < 24; h++) {
  for (const m of [0, 30]) times.push(`${pad(h)}:${pad(m)}`);
}

const total = t.steps.length;
---

<!-- ═══ BANDEAU TITRE ══════════════════════════════════════════════════════ -->
<section class="gc-page-hero">
  <div class="gc-page-hero-inner">
    <span class="gc-page-eyebrow">{t.hero.eyebrow}</span>
    <h1 class="gc-page-h1">{t.hero.title}</h1>
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ FORMULAIRE ═════════════════════════════════════════════════════════ -->
<section class="gc-qf-main gc-reveal">
  <div class="gc-qf-inner">
    <div class="gc-qf-lead">
      <h2 class="gc-qf-lead-title">{t.intro.title}</h2>
      <p class="gc-qf-lead-text">{t.intro.paragraph}</p>
      <p class="gc-qf-lead-phone gc-body-text">
        {t.intro.phoneLead}
        <a href={QUOTE_CONTACT.phoneHref} data-track="call-click">{QUOTE_CONTACT.phoneDisplay}</a>.
      </p>
    </div>

    <div class="gc-qf-card" id="gc-qf-card">
      <ol class="gc-qf-progress" aria-hidden="true">
        {t.steps.map((s, i) => (
          <li class:list={['gc-qf-progress-item', i === 0 && 'is-active']}>
            <span class="gc-qf-progress-num">{pad(i + 1)}</span>
            <span class="gc-qf-progress-label">{s.title}</span>
          </li>
        ))}
      </ol>
      <div class="gc-qf-track" aria-hidden="true"><span class="gc-qf-track-fill"></span></div>
      <p class="gc-qf-stepcount" id="gc-qf-stepcount" aria-live="polite"></p>

      <div id="gc-qf-error" class="gc-qf-msg gc-qf-msg--error" role="alert" hidden>{ui.errorMessage}</div>

      <form
        id="gc-qf-form"
        class="gc-qf-form"
        novalidate
        data-form={t.formKey}
        data-lang={locale}
        data-endpoint={QUOTE_ENDPOINT}
        data-step-of={ui.stepOf}
        data-submit-text={ui.submit}
        data-sending-text={ui.sending}
      >
        {t.steps.map((step, si) => (
          <div class="gc-qf-step" data-step={si} data-title={step.title} role="group" aria-labelledby={`gc-qf-title-${si}`} hidden={si !== 0}>
            <h2 class="gc-qf-step-title" id={`gc-qf-title-${si}`} tabindex="-1">{step.title}</h2>
            {step.intro && <p class="gc-qf-step-intro gc-body-text">{step.intro}</p>}

            <div class="gc-qf-grid">
              {step.fields.map((f, fi) => {
                if (f.type === 'heading') {
                  return <h3 class="gc-qf-group-title">{f.label}</h3>;
                }
                const id = `qf-${f.name}`;
                const opts = (f.options ?? []).map(norm);
                const label = (
                  <>
                    {f.label}
                    {f.optional && <span class="gc-qf-note"> {ui.optional}</span>}
                  </>
                );
                return (
                  <div
                    class:list={['gc-qf-field', f.half && 'gc-qf-half']}
                    data-field={f.name}
                    data-show-field={f.showIf?.field}
                    data-show-equals={f.showIf?.equals}
                    data-show-not-equals={f.showIf?.notEquals}
                    data-show-includes={f.showIf?.includes}
                    hidden={!!f.showIf}
                  >
                    {f.type === 'checks' ? (
                      <fieldset class="gc-qf-checks" data-required={f.required ? '1' : undefined}>
                        <legend>{label}</legend>
                        <div class="gc-qf-chips">
                          {opts.map((o) => (
                            <label class="gc-qf-chip">
                              <input type="checkbox" name={f.name} value={o.value} />
                              <span>{o.label}</span>
                            </label>
                          ))}
                        </div>
                        {f.hint && <p class="gc-qf-hint">{f.hint}</p>}
                        <p class="gc-qf-err" role="alert" hidden>{ui.checksError}</p>
                      </fieldset>
                    ) : f.type === 'timerange' ? (
                      <fieldset class="gc-qf-times">
                        <legend>{label}</legend>
                        <div class="gc-qf-times-row">
                          <label class="gc-qf-times-cell">
                            <span>{ui.timeFrom}</span>
                            <select name="heure_debut" required={f.required}>
                              <option value="" disabled selected>{ui.timePlaceholder}</option>
                              {times.map((tm) => <option value={tm}>{tm}</option>)}
                            </select>
                          </label>
                          <label class="gc-qf-times-cell">
                            <span>{ui.timeTo}</span>
                            <select name="heure_fin" required={f.required}>
                              <option value="" disabled selected>{ui.timePlaceholder}</option>
                              {times.map((tm) => <option value={tm}>{tm}</option>)}
                            </select>
                          </label>
                        </div>
                        {f.hint && <p class="gc-qf-hint">{f.hint}</p>}
                      </fieldset>
                    ) : f.type === 'select' ? (
                      <>
                        <label for={id}>{label}</label>
                        <select id={id} name={f.name} required={f.required} autocomplete={f.autocomplete}>
                          <option value="" disabled selected>{f.placeholder ?? ''}</option>
                          {opts.map((o) => <option value={o.value}>{o.label}</option>)}
                        </select>
                        {f.hint && <p class="gc-qf-hint">{f.hint}</p>}
                      </>
                    ) : f.type === 'textarea' ? (
                      <>
                        <label for={id}>{label}</label>
                        <textarea id={id} name={f.name} rows="5" placeholder={f.placeholder} required={f.required}></textarea>
                        {f.hint && <p class="gc-qf-hint">{f.hint}</p>}
                      </>
                    ) : (
                      <>
                        <label for={id}>{label}</label>
                        <input
                          id={id}
                          name={f.name}
                          type={f.type}
                          required={f.required}
                          autocomplete={f.autocomplete}
                          placeholder={f.placeholder}
                          min={f.type === 'number' ? '0' : undefined}
                          step={f.type === 'number' ? '50' : undefined}
                          inputmode={f.type === 'number' ? 'numeric' : f.type === 'tel' ? 'tel' : undefined}
                        />
                        {f.hint && <p class="gc-qf-hint">{f.hint}</p>}
                      </>
                    )}
                  </div>
                );
              })}

              {si === total - 1 && (
                <label class="gc-qf-consent">
                  <input type="checkbox" name="consent" value="1" required />
                  <span>
                    {ui.consentBefore}<a href={ui.consentHref} target="_blank" rel="noopener">{ui.consentLinkText}</a>{ui.consentAfter}
                  </span>
                </label>
              )}
            </div>
          </div>
        ))}

        <!-- Anti-spam (honeypot) : ne pas remplir — même principe que le formulaire Contact -->
        <input type="text" name="website_hp" value="" class="gc-qf-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="gc-qf-actions">
          <div class="gc-btn-pair gc-qf-pair">
            <button type="button" class="btn-gc gc-qf-back" data-qf-back hidden>{ui.back}</button>
            <button type="button" class="btn-gc-primary gc-qf-primary" data-qf-next>{ui.next}</button>
            <button type="submit" class="btn-gc-primary gc-qf-primary" data-qf-submit hidden>{ui.submit}</button>
          </div>
        </div>
      </form>

      <div id="gc-qf-success" class="gc-qf-success" role="status" tabindex="-1" hidden>
        <span class="gc-qf-success-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
        </span>
        <h2 class="gc-qf-success-title">{ui.successTitle}</h2>
        <p class="gc-qf-success-text gc-body-text">{ui.successText}</p>
        <a href={ui.successCta.href} class="btn-gc-primary">{ui.successCta.text}</a>
      </div>
    </div>
  </div>
</section>

<script>
  type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const initQuoteForm = () => {
    const form = document.getElementById('gc-qf-form') as HTMLFormElement | null;
    const card = document.getElementById('gc-qf-card');
    if (!form || !card || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const steps = Array.from(form.querySelectorAll<HTMLElement>('.gc-qf-step'));
    const progressItems = Array.from(card.querySelectorAll<HTMLElement>('.gc-qf-progress-item'));
    const fill = card.querySelector<HTMLElement>('.gc-qf-track-fill');
    const stepCount = document.getElementById('gc-qf-stepcount');
    const errorEl = document.getElementById('gc-qf-error');
    const successEl = document.getElementById('gc-qf-success');
    const btnBack = form.querySelector<HTMLButtonElement>('[data-qf-back]');
    const btnNext = form.querySelector<HTMLButtonElement>('[data-qf-next]');
    const btnSubmit = form.querySelector<HTMLButtonElement>('[data-qf-submit]');
    if (!btnBack || !btnNext || !btnSubmit) return;

    const loadedAt = Date.now();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stepOf = form.dataset.stepOf || '{n}/{total}';
    let current = 0;

    // Date : pas de date passée
    const today = new Date().toLocaleDateString('en-CA');
    form.querySelectorAll<HTMLInputElement>('input[type="date"]').forEach((el) => (el.min = today));

    // ── Champs conditionnels ────────────────────────────────────────────────
    const valuesOf = (name: string): string[] => {
      const els = Array.from(form.elements).filter((e) => (e as Control).name === name) as Control[];
      const out: string[] = [];
      els.forEach((e) => {
        if (e instanceof HTMLInputElement && e.type === 'checkbox') {
          if (e.checked) out.push(e.value);
        } else if (e.value) {
          out.push(e.value);
        }
      });
      return out;
    };

    const applyConditions = () => {
      form.querySelectorAll<HTMLElement>('[data-show-field]').forEach((wrap) => {
        const vals = valuesOf(wrap.dataset.showField || '');
        let show = true;
        if (wrap.dataset.showEquals !== undefined) show = vals.includes(wrap.dataset.showEquals);
        if (wrap.dataset.showNotEquals !== undefined) show = vals.length > 0 && !vals.includes(wrap.dataset.showNotEquals);
        if (wrap.dataset.showIncludes !== undefined) show = vals.includes(wrap.dataset.showIncludes);
        wrap.hidden = !show;
        wrap.querySelectorAll<Control>('input, select, textarea').forEach((c) => (c.disabled = !show));
      });
    };

    // ── Navigation ──────────────────────────────────────────────────────────
    const showStep = (i: number, focus: boolean) => {
      current = i;
      steps.forEach((s, idx) => (s.hidden = idx !== i));
      progressItems.forEach((p, idx) => {
        p.classList.toggle('is-active', idx === i);
        p.classList.toggle('is-done', idx < i);
      });
      if (fill) fill.style.width = `${((i + 1) / steps.length) * 100}%`;
      if (stepCount) {
        const label = stepOf.replace('{n}', String(i + 1)).replace('{total}', String(steps.length));
        stepCount.textContent = `${label} — ${steps[i].dataset.title || ''}`;
      }
      btnBack.hidden = i === 0;
      btnNext.hidden = i === steps.length - 1;
      btnSubmit.hidden = i !== steps.length - 1;
      if (focus) {
        card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        steps[i].querySelector<HTMLElement>('.gc-qf-step-title')?.focus({ preventScroll: true });
      }
    };

    const validateStep = (i: number): boolean => {
      const step = steps[i];
      let firstBad: HTMLElement | null = null;

      // Groupes de cases à cocher obligatoires
      step.querySelectorAll<HTMLElement>('fieldset.gc-qf-checks[data-required="1"]').forEach((fs) => {
        const wrap = fs.closest<HTMLElement>('.gc-qf-field');
        if (wrap && wrap.hidden) return;
        const any = fs.querySelector('input:checked');
        const err = fs.querySelector<HTMLElement>('.gc-qf-err');
        if (err) err.hidden = !!any;
        if (!any && !firstBad) firstBad = fs.querySelector<HTMLElement>('input');
      });

      // Autres champs
      let firstNative: Control | null = null;
      step.querySelectorAll<Control>('input, select, textarea').forEach((c) => {
        if (c.disabled || c.name === 'website_hp') return;
        if (!c.checkValidity() && !firstNative) firstNative = c;
      });

      if (firstNative) {
        (firstNative as Control).reportValidity();
        return false;
      }
      if (firstBad) {
        (firstBad as HTMLElement).focus();
        return false;
      }
      return true;
    };

    const goNext = () => {
      if (!validateStep(current)) return;
      if (current < steps.length - 1) showStep(current + 1, true);
    };

    btnNext.addEventListener('click', goNext);
    btnBack.addEventListener('click', () => {
      if (current > 0) showStep(current - 1, true);
    });

    form.addEventListener('change', (e) => {
      applyConditions();
      const t = e.target as HTMLElement;
      const fs = t.closest('fieldset.gc-qf-checks');
      if (fs) {
        const err = fs.querySelector<HTMLElement>('.gc-qf-err');
        if (err && fs.querySelector('input:checked')) err.hidden = true;
      }
    });

    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const tag = (e.target as HTMLElement).tagName;
      if (tag === 'TEXTAREA' || tag === 'BUTTON') return;
      e.preventDefault();
      if (current < steps.length - 1) goNext();
      else btnSubmit.click();
    });

    // ── Envoi ───────────────────────────────────────────────────────────────
    const collect = () => {
      const fields: Record<string, string | string[]> = {};
      const labels: Record<string, string | string[]> = {};
      const push = (obj: Record<string, string | string[]>, key: string, val: string) => {
        const cur = obj[key];
        if (Array.isArray(cur)) cur.push(val);
        else obj[key] = [val];
      };
      Array.from(form.elements).forEach((el) => {
        const c = el as Control;
        if (!c.name || c.disabled || c.name === 'website_hp' || c instanceof HTMLButtonElement) return;
        if (c instanceof HTMLInputElement && c.type === 'checkbox') {
          if (!c.checked) return;
          if (c.name === 'consent') {
            fields.consent = '1';
            return;
          }
          push(fields, c.name, c.value);
          push(labels, c.name, c.closest('label')?.querySelector('span')?.textContent?.trim() || c.value);
          return;
        }
        if (!c.value) return;
        fields[c.name] = c.value.trim();
        if (c instanceof HTMLSelectElement) labels[c.name] = c.selectedOptions[0]?.textContent?.trim() || c.value;
      });
      return { fields, labels };
    };

    const showSuccess = () => {
      card.classList.add('is-sent');
      form.hidden = true;
      if (successEl) {
        successEl.hidden = false;
        successEl.focus({ preventScroll: true });
      }
      card.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      const w = window as unknown as { dataLayer?: Array<Record<string, unknown>> };
      w.dataLayer?.push({ event: 'quote_request_submit', quote_type: form.dataset.form, lang: form.dataset.lang });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl?.setAttribute('hidden', '');

      // Honeypot : rempli → on abandonne en silence
      const hp = form.querySelector<HTMLInputElement>('input[name="website_hp"]');
      if (hp && hp.value) return;
      // Trop rapide pour un humain → suspect
      const elapsed = Date.now() - loadedAt;
      if (elapsed < 5000) return;
      if (!validateStep(current)) return;

      btnSubmit.disabled = true;
      btnSubmit.textContent = form.dataset.sendingText || '…';

      const { fields, labels } = collect();
      const payload = {
        rid: typeof crypto !== 'undefined' && 'randomUUID' in crypto ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`,
        form: form.dataset.form,
        lang: form.dataset.lang,
        page: location.pathname,
        elapsed,
        hp: hp ? hp.value : '',
        fields,
        labels,
      };

      try {
        const endpoint = form.dataset.endpoint || '';
        if (endpoint.includes('REMPLACER')) {
          // Script Google pas encore configuré : simulation uniquement en local, jamais en production.
          if (['localhost', '127.0.0.1'].includes(location.hostname)) {
            console.info('[devis] URL du script non configurée — mode démo. Données :', payload);
            await new Promise((r) => setTimeout(r, 700));
          } else {
            throw new Error('Endpoint devis non configuré');
          }
        } else {
          // Corps en text/plain : requête « simple », sans préflight CORS (Apps Script).
          await fetch(endpoint, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload),
          });
        }
        showSuccess();
      } catch {
        errorEl?.removeAttribute('hidden');
        errorEl?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      } finally {
        btnSubmit.disabled = false;
        btnSubmit.textContent = form.dataset.submitText || '';
      }
    });

    applyConditions();
    showStep(0, false);
  };

  initQuoteForm();
  document.addEventListener('astro:page-load', initQuoteForm);
</script>

<script>
  // Apparition au scroll (même mécanisme que Contact / Services) : ré-armé à chaque
  // chargement de page pour survivre au changement de langue (ClientRouter).
  let observer: IntersectionObserver | null = null;

  const initReveal = () => {
    observer?.disconnect();
    const revealEls = document.querySelectorAll<HTMLElement>('.gc-reveal');
    if (!revealEls.length) return;
    observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -25% 0px' }
    );
    revealEls.forEach((el) => observer!.observe(el));
  };

  document.addEventListener('astro:page-load', initReveal);
</script>

<style>
  /* Toutes les couleurs proviennent des variables de palette (voir tailwind.css) :
     --gc-surface #FFFFFF · --gc-surface-alt #F2F2F2 · --gc-ink #0D0D0D · --gc-gold #AF9453 */

  /* Bandeau titre : voir .gc-page-hero / .gc-page-h1 (classes partagées, tailwind.css) */

  /* L'attribut hidden doit toujours l'emporter (les classes d'affichage ci-dessous le masqueraient sinon) */
  .gc-qf-main [hidden] { display: none !important; }

  .gc-qf-main {
    background-color: var(--gc-surface-alt);
    padding: clamp(3rem, 8vh, 5rem) 1.25rem clamp(4rem, 10vh, 6rem);
  }
  .gc-qf-inner { max-width: 48rem; margin-inline: auto; }

  /* ── Introduction ────────────────────────────────────────────────────── */
  .gc-qf-lead { text-align: center; margin-bottom: 2.5rem; }
  .gc-qf-lead-title {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--gc-ink);
    margin-bottom: 1rem;
  }
  .gc-qf-lead-text {
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.6;
    color: var(--gc-ink);
    max-width: 38rem;
    margin: 0 auto 1rem;
  }
  .gc-qf-lead-phone { color: var(--gc-ink); opacity: 0.8; margin: 0; }

  /* ── Carte du formulaire ─────────────────────────────────────────────── */
  .gc-qf-card {
    background-color: var(--gc-surface);
    border-radius: 0.65rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: 0 40px 70px -40px #0D0D0D40;
  }

  /* Progression */
  .gc-qf-progress {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 1rem;
    padding: 0;
  }
  .gc-qf-progress-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #0D0D0D66;
    transition: color 0.4s ease;
  }
  .gc-qf-progress-num { letter-spacing: 0.2em; }
  .gc-qf-progress-item.is-done { color: var(--gc-gold); }
  .gc-qf-progress-item.is-active { color: var(--gc-ink); }
  .gc-qf-progress-item.is-active .gc-qf-progress-num { color: var(--gc-gold); }
  @media (max-width: 559px) {
    .gc-qf-progress-label { display: none; }
    .gc-qf-progress-item.is-active .gc-qf-progress-label { display: inline; }
  }

  .gc-qf-track { height: 2px; background-color: #0D0D0D14; border-radius: 2px; overflow: hidden; }
  .gc-qf-track-fill {
    display: block;
    height: 100%;
    width: 25%;
    background: linear-gradient(90deg, #8A7440, #AF9453);
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gc-qf-stepcount {
    font-size: 0.75rem;
    color: var(--gc-ink);
    opacity: 0.6;
    margin: 0.75rem 0 2rem;
  }
  .gc-qf-card.is-sent .gc-qf-progress,
  .gc-qf-card.is-sent .gc-qf-track,
  .gc-qf-card.is-sent .gc-qf-stepcount { display: none; }

  .gc-qf-msg {
    padding: 0.85rem 1.1rem;
    border-radius: 0.4rem;
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .gc-qf-msg--error { background: #FBEAEA; color: #8A2E2E; border: 1px solid #F0C6C6; }

  /* Étape */
  .gc-qf-step-title {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--gc-ink);
    margin-bottom: 0.5rem;
  }
