<!-- ═══ 10. LOCALISATION ═══════════════════════════════════════════════════ -->
<section class="gc-sec gc-sec--white gc-mar-loc" aria-labelledby="gc-mar-loc-title">
  <div class="gc-sec-inner gc-mar-wide">
    <div class="gc-sec-head gc-reveal">
      <span class="gc-sec-accroche">{t.localisation.surtitre}</span>
      <h2 id="gc-mar-loc-title" class="gc-sec-title">
        {T(t.localisation.titre_blanc)}<br class="gc-br-lg" /> <span class="gc-mar-gold">{T(t.localisation.titre_or)}</span>
      </h2>
      <p class="gc-body-text" set:html={lignes(t.localisation.texte, '<br class="gc-br-lg" /> ')} />
    </div>

    <div class="gc-mar-geo">
      <figure class="gc-mar-map gc-reveal" data-map>
        <svg viewBox="0 0 600 500" role="img" aria-labelledby="gc-mar-map-cap">
          <rect width="600" height="500" class="gc-mar-map-sea" />
          <path d={carte.terre} class="gc-mar-map-land" />
          <path d={carte.cote} class="gc-mar-map-coast" />
          <path d={carte.frontiere} class="gc-mar-map-border" />
          <path d={carte.adour} class="gc-mar-map-river" />
          <text x={oceanX} y={oceanY} class="gc-mar-map-sea-label" transform={`rotate(-72 ${oceanX} ${oceanY})`}>{carte.ocean}</text>
          <text x={espX} y={espY} class="gc-mar-map-region">{carte.espagne}</text>
          <text x={landesX} y={landesY} class="gc-mar-map-region">Landes</text>
          <text x={pbX} y={pbY} class="gc-mar-map-region">{locale === 'fr' ? 'Pays Basque' : 'Basque Country'}</text>
          {carte.villes.map((v) => (
            <g class="gc-mar-map-city">
              <circle cx={v.x} cy={v.y} r="2.5" />
              <text x={v.x + v.dx} y={v.y + v.dy} text-anchor={v.ancre}>{v.nom}</text>
            </g>
          ))}
          {carte.points.map((p, i) => (
            <g class="gc-mar-map-pt" data-i={i}>
              <circle cx={p.x} cy={p.y} r="9" class="gc-mar-map-halo" />
              <circle cx={p.x} cy={p.y} r="4.2" class="gc-mar-map-dot"><title>{p.nom}</title></circle>
            </g>
          ))}
          <g class="gc-mar-map-world">
            <path d="M470 70 L548 30 M532 28 L548 30 L541 45" />
            <text x="560" y="94" text-anchor="end">{carte.monde}</text>
          </g>
        </svg>
        <figcaption id="gc-mar-map-cap">{T(t.localisation.carte_legende)}</figcaption>
      </figure>

      <div class="gc-mar-zones">
        <h3 class="gc-mar-sub">{T(t.localisation.zones_titre)}</h3>
        <ul>
          {zones.map((z) => (
            <li class="gc-mar-zone gc-reveal">
              <span class="gc-mar-card-kicker">{T(z.surtitre)}</span>
              <h4 class="gc-mar-card-title">{T(z.titre)}</h4>
              <p class="gc-body-text" set:html={L(z.texte)} />
              {z.lien && <a class="gc-prt-cta" href={z.lien}>{T(t.localisation.lien_texte)}</a>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <h3 class="gc-mar-sub gc-mar-sub--center gc-reveal">{T(t.localisation.lieux_titre)}</h3>
  </div>

  <div class="gc-evt-gal gc-evt-gal--portrait" data-gal>
    <div class="gc-evt-gal-wrap">
      <ul class="gc-evt-gal-track" data-gal-track tabindex="0" aria-label={B(t.localisation.lieux_titre)}>
        {lieuxPhotos.map((l) => (
          <li class="gc-evt-gal-item">
            <figure class="gc-evt-gal-fig">
              <div class="gc-media-hover gc-mar-venue-img">
                <Image src={l.img} alt={`${l.nom}, ${l.ville}`} widths={[400, 600, 900]} sizes="(min-width: 1024px) 22vw, (min-width: 768px) 34vw, 70vw" loading="lazy" decoding="async" />
              </div>
              <figcaption><strong class="gc-mar-venue-name">{T(l.nom)}</strong>{T(l.ville)}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <div class="gc-evt-gal-nav">
        <button type="button" class="gc-evt-gal-btn" data-gal-prev aria-label={carrousel.precedent}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="gc-evt-gal-btn gc-evt-gal-btn--pause" data-gal-pause aria-pressed="false" aria-label={carrousel.pause} data-label-pause={carrousel.pause} data-label-play={carrousel.lecture}>
          <svg class="gc-evt-gal-ico-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <svg class="gc-evt-gal-ico-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
        </button>
        <button type="button" class="gc-evt-gal-btn" data-gal-next aria-label={carrousel.suivant}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </div>
  <p class="gc-body-text gc-mar-venues-more" set:html={L(t.localisation.autres)} />
</section>

