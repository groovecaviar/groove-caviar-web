  .gc-mar-sub--center { text-align: center; margin-bottom: 2rem; }
  .gc-mar-zones ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .gc-mar-zone, .gc-mar-card { background: var(--gc-surface); border: 1px solid #0D0D0D1A; padding: 1.4rem 1.5rem; transition: border-color 0.25s ease; }
  .gc-mar-zone:hover, .gc-mar-card:hover { border-color: var(--gc-gold); }
  .gc-mar-card-kicker {
