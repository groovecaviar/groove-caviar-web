---
// Page pilier « Mariages » (FR /mariages ↔ EN /en/weddings)
// Textes : src/data/textes/mariages.fr.yaml (mise à jour à chaud avec npm run dev).
// Réutilise les blocs communs du site (hero photo, bandeau intro, titres de
// section, FAQ, bandeau citation, CTA final, carrousel) ; les classes gc-mar-*
// ne concernent que ce qui est propre à cette page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImg from '~/assets/images/MARIAGES-hero.webp';
import { estRempli, type MariagesContent } from '~/data/pages/mariages';
import { ligne, paragraphes, texteBrut, typo, pageExiste, type Locale } from '~/utils/textes';

export interface Props {
  t: MariagesContent;
  locale: Locale;
}

const { t, locale } = Astro.props;

// ── Compteur d avis : {google_avis} remplacé partout ──
const C = (s: string) => s.replace(/\{google_avis\}/g, t.compteurs_avis.google_avis);
const L = (s: string) => ligne(C(s), locale);
const P = (s: string) => paragraphes(C(s), locale);
const T = (s: string) => typo(C(s), locale);
const B = (s: string) => texteBrut(C(s), locale);

// ── Images (dossiers src/assets/images/mariages, avis, lieux) ───────────────
type ImgMap = Record<string, { default: ImageMetadata }>;
// Les noms de fichiers sont comparés sans tenir compte des majuscules (DJ-Pierre = dj-pierre).
const parNom = (g: ImgMap) =>
  Object.fromEntries(Object.entries(g).map(([k, v]) => [k.split('/').pop()!.replace(/\.(webp|jpe?g|png)$/i, '').toLowerCase(), v.default]));
const imgMariages = parNom(import.meta.glob<{ default: ImageMetadata }>('~/assets/images/mariages/*.{webp,jpg,jpeg,png}', { eager: true }));
const imgAvis = parNom(import.meta.glob<{ default: ImageMetadata }>('~/assets/images/avis/*.{webp,jpg,jpeg,png}', { eager: true }));
const imgBadges = parNom(import.meta.glob<{ default: ImageMetadata }>('~/assets/images/badges/*.{webp,jpg,jpeg,png}', { eager: true }));
const imgLieux = parNom(import.meta.glob<{ default: ImageMetadata }>('~/assets/images/lieux/*.{webp,jpg,jpeg,png}', { eager: true }));

const exiger = (map: Record<string, ImageMetadata>, nom: string, dossier: string) => {
  const img = map[nom.toLowerCase()];
  if (!img) throw new Error(`Page Mariages : image « ${nom}.webp » introuvable dans src/assets/images/${dossier}/`);
  return img;
};
const slug = (s: string) =>
  s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// ── 4. Déroulé : une photo par moment, dans l'ordre ──────────────────────────
const PHOTOS_MOMENTS = ['ceremonie', 'cocktail', 'diner', 'ouverture-bal', 'soiree', 'dernier-morceau', 'moment-7', 'moment-8'];
const NB_CLAIRS = 3; // les 3 premiers moments sur fond clair (jour), les suivants sur fond sombre (nuit)
const moments = t.deroule.moments.map((m, i) => ({
  ...m,
  img: exiger(imgMariages, `MARIAGES-${PHOTOS_MOMENTS[i]}`, 'mariages'),
  nuit: i >= NB_CLAIRS,
  etiquettes: m.etiquettes ?? [],
}));

// ── 5. Avis : seuls les avis complétés (sans ⚠️) s'affichent ─────────────────
const aLaUne = t.avis.a_la_une
  .filter((a) => estRempli(a.texte) && estRempli(a.date))
  .map((a) => ({ ...a, img: exiger(imgAvis, `avis-${a.portrait}`, 'avis') }));
const avisListe = t.avis.liste.filter((a) => estRempli(a.texte) && estRempli(a.initiales) && estRempli(a.date));
const LONG = 260; // au-delà, l'avis est replié avec « Lire la suite »
const LONG_UNE = 450; // avis « à la une » plus long : police un peu plus petite
const lienGoogle = 'https://maps.app.goo.gl/sJXkZtVEC7YZbHtn8';
const libelles = locale === 'fr'
  ? { suite: 'Lire la suite', moins: 'Réduire', precedent: 'Avis précédent', suivant: 'Avis suivant' }
  : { suite: 'Read more', moins: 'Show less', precedent: 'Previous review', suivant: 'Next review' };

// ── 6. DJs ───────────────────────────────────────────────────────────────────
const djs = t.djs.liste.map((d) => ({
  ...d,
  img: exiger(imgMariages, d.photo, 'mariages'),
}));

// ── 8. Bien plus qu'un prix : le montant en euros devient un compteur ───────
const avantages = t.avantages.points.map((p, i) => {
  const m = p.titre.match(/(\d[\d\s  ]*\d|\d)/);
  const num = String(i + 1).padStart(2, '0');
  if (!m || m.index === undefined) return { ...p, num, avant: p.titre, chiffre: '', valeur: 0, apres: '' };
  return {
    ...p,
    num,
    avant: p.titre.slice(0, m.index),
    chiffre: m[0],
    valeur: Number(m[0].replace(/\D/g, '')),
    apres: p.titre.slice(m.index + m[0].length),
  };
});

// ── 10. Localisation : carte stylisée (SVG maison, aucun service externe) ────
//  Coordonnées approximatives (lon, lat) des lieux où nous avons joué.
const LIEUX_CARTE: [string, number, number][] = [
  ["Hôtel du Palais", -1.556, 43.486], ['Château du Clair de Lune', -1.548, 43.465], ['Domaine Elhorria', -1.538, 43.452],
  ["Château d'Arcangues", -1.523, 43.432], ['Théâtre de la Nature', -1.518, 43.428], ['Château de Larraldia', -1.452, 43.437],
  ['Domaine de Larbéou', -1.468, 43.468], ["Espace de l'Océan", -1.532, 43.512], ['Espace Maïténa', -1.505, 43.493],
  ['Maison Chiberta', -1.522, 43.527], ['Château de Brindos', -1.505, 43.478], ['Domaine Arremonteguy', -1.293, 43.49], ['La Ferme aux Piments', -1.534, 43.358],
  ['Ferme Inharria', -1.548, 43.348], ['Ferme Ostalapia', -1.592, 43.4], ['Les Hortensias du Lac', -1.432, 43.665],
  ["70 Hectares & l'Océan", -1.415, 43.705], ['Château de Monbet', -1.112, 43.613], ['Château de Campet', -0.612, 43.925],
  ['Domaine de Tilh', -0.737, 43.43],
];
const LON0 = -2.1, LAT0 = 44.15, K = 500, COS = 0.724;
const px = (lon: number, lat: number) => [Math.round((lon - LON0) * COS * K * 10) / 10, Math.round((LAT0 - lat) * K * 10) / 10];
const chemin = (pts: [number, number][], ferme = false) =>
  pts.map(([lo, la], i) => `${i ? 'L' : 'M'}${px(lo, la).join(' ')}`).join(' ') + (ferme ? ' Z' : '');
const COTE: [number, number][] = [
  [-1.27, 44.15], [-1.31, 44.0], [-1.36, 43.85], [-1.42, 43.72], [-1.445, 43.65], [-1.48, 43.57], [-1.52, 43.525],
  [-1.555, 43.49], [-1.58, 43.45], [-1.6, 43.42], [-1.64, 43.4], [-1.67, 43.39], [-1.72, 43.385], [-1.78, 43.37],
  [-1.8, 43.35], [-1.88, 43.33], [-1.98, 43.32], [-2.1, 43.3],
];
const carte = {
  terre: chemin([...COTE, [-2.1, 43.15], [-0.45, 43.15], [-0.45, 44.15]], true),
  cote: chemin(COTE),
  frontiere: chemin([[-1.79, 43.36], [-1.66, 43.29], [-1.5, 43.27], [-1.38, 43.2], [-1.28, 43.15]]),
  adour: chemin([[-1.52, 43.525], [-1.45, 43.5], [-1.3, 43.53], [-1.1, 43.55], [-0.95, 43.64], [-0.75, 43.71], [-0.45, 43.75]]),
  points: LIEUX_CARTE.map(([nom, lo, la]) => {
    const [x, y] = px(lo, la);
    return { nom, x, y };
  }),
  villes: [
    { nom: 'Biarritz', lo: -1.556, la: 43.483, ancre: 'end', dx: -12, dy: 4 },
    { nom: 'Bayonne', lo: -1.475, la: 43.493, ancre: 'start', dx: 12, dy: -6 },
    { nom: 'Hossegor', lo: -1.44, la: 43.665, ancre: 'start', dx: 12, dy: 4 },
    { nom: 'Saint-Jean-de-Luz', lo: -1.66, la: 43.388, ancre: 'end', dx: -12, dy: 10 },
    { nom: 'Dax', lo: -1.053, la: 43.71, ancre: 'start', dx: 10, dy: 4 },
  ].map((v) => {
    const [x, y] = px(v.lo, v.la);
    return { ...v, x, y };
  }),
  ocean: locale === 'fr' ? 'Océan Atlantique' : 'Atlantic Ocean',
  espagne: locale === 'fr' ? 'Espagne' : 'Spain',
  monde: locale === 'fr' ? 'Paris · France · Monde' : 'Paris · France · Worldwide',
};
const [oceanX, oceanY] = px(-1.88, 43.85);
const [espX, espY] = px(-1.95, 43.22);
const [landesX, landesY] = px(-0.98, 43.86);
const [pbX, pbY] = px(-1.2, 43.3);

const lieuxPhotos = t.localisation.avec_photo.map((l) => ({ ...l, img: exiger(imgLieux, slug(l.nom), 'lieux') }));
const zones = t.localisation.zones.map((z) => ({ ...z, lien: z.page && pageExiste(z.page) ? z.page : '' }));
const cartesCouples = t.couples.cartes.map((c) => ({ ...c, lien: c.page && pageExiste(c.page) ? c.page : '' }));
const badges = (t.couples.badges ?? []).map((b) => ({ ...b, img: exiger(imgBadges, b.image, 'badges') }));
// Texte sur plusieurs lignes dans le fichier : chaque ligne devient une ligne à l'écran.
const lignes = (s: string, br = '<br />') => s.trim().split(/\n+/).map((l) => L(l)).join(br);
const exergue = t.couples.exergue.trim().split(/\n+/).map((l) => L(l)).join('<br />');
const carrousel = locale === 'fr'
  ? { precedent: 'Lieu précédent', suivant: 'Lieu suivant', pause: 'Mettre le défilement en pause', lecture: 'Reprendre le défilement' }
  : { precedent: 'Previous venue', suivant: 'Next venue', pause: 'Pause the slideshow', lecture: 'Resume the slideshow' };
const film = locale === 'fr'
  ? { pause: 'Mettre la vidéo en pause', lecture: 'Lire la vidéo' }
  : { pause: 'Pause the video', lecture: 'Play the video' };
// Vidéo : fichiers dans public/videos (720 px pour mobile, 1280 px pour ordinateur)
const VIDEO = {
  petit: '/videos/mariage-groove-caviar-720.mp4',
  grand: '/videos/mariage-groove-caviar-1280.mp4',
  affiche: '/videos/mariage-groove-caviar-poster.webp',
};

// ── Données structurées (JSON-LD) ────────────────────────────────────────────
const SITE_URL = 'https://www.groovecaviar.com';
const pagePath = locale === 'fr' ? '/mariages' : '/en/weddings';
const pageUrl = `${SITE_URL}${pagePath}`;
const homeUrl = locale === 'fr' ? `${SITE_URL}/` : `${SITE_URL}/en`;
const villes = ['Biarritz', 'Anglet', 'Bayonne', 'Saint-Jean-de-Luz', 'Guéthary', 'Bidart', 'Arcangues', 'Hossegor', 'Seignosse', 'Capbreton'];
const prixMin = Number(t.tarifs.formule.prix.replace(/\D/g, '')) || undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.seo.titre,
      description: t.seo.description,
      inLanguage: locale,
      isPartOf: { '@id': `${SITE_URL}#website` },
      about: { '@id': SITE_URL },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      primaryImageOfPage: `${SITE_URL}${heroImg.src}`,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: locale === 'fr' ? 'Accueil' : 'Home', item: homeUrl },
        { '@type': 'ListItem', position: 2, name: `${t.hero.titre_blanc} ${t.hero.titre_or}`, item: pageUrl },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: `${t.hero.titre_blanc} ${t.hero.titre_or} — Groove Caviar`,
      serviceType: locale === 'fr' ? 'DJ de mariage' : 'Wedding DJ',
      description: B(t.intro.texte),
      url: pageUrl,
      provider: { '@id': SITE_URL },
      availableLanguage: ['fr', 'en', 'es'],
      areaServed: [
        ...villes.map((name) => ({ '@type': 'City', name })),
        { '@type': 'AdministrativeArea', name: locale === 'fr' ? 'Pays Basque' : 'Basque Country' },
        { '@type': 'AdministrativeArea', name: 'Landes' },
        { '@type': 'Country', name: 'France' },
      ],
      ...(prixMin
        ? {
            offers: {
              '@type': 'AggregateOffer',
              priceCurrency: 'EUR',
              lowPrice: prixMin,
              description: B(`${t.tarifs.formule.nom} — ${t.tarifs.formule.a_partir_de} ${t.tarifs.formule.prix} ${t.tarifs.formule.saison}`),
            },
          }
        : {}),
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage: locale,
      mainEntity: t.faq.questions.map((q) => ({
        '@type': 'Question',
        name: B(q.question),
        acceptedAnswer: { '@type': 'Answer', text: B(q.reponse) },
      })),
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<!-- ═══ 1. HERO (identique aux autres pages piliers) ══════════════════════ -->
<section class="gc-hero-section gc-photo-hero" data-mar-hero>
  <Image
    src={heroImg}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="gc-hero-media gc-photo-hero-bg"
  />
  <div class="gc-photo-hero-overlay" aria-hidden="true"></div>
  <div class="gc-photo-hero-content">
    <span class="gc-page-eyebrow">{t.hero.surtitre}</span>
    <h1 class="gc-photo-hero-h1 gc-photo-hero-h1-zoom">
      <span class="gc-photo-hero-h1-white">{t.hero.titre_blanc}</span>
      {' '}
      <span class="gc-photo-hero-h1-gold gc-shimmer gc-mar-accent-safe">{t.hero.titre_or}</span>
    </h1>
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ 2. CHIFFRES CLÉS ═══════════════════════════════════════════════════ -->
<section class="gc-mar-stats" aria-label={locale === 'fr' ? 'Chiffres clés' : 'Key figures'}>
  <ul class="gc-mar-stats-list">
    {t.chiffres.map((c) => (
      <li><strong>{c.valeur}</strong><span>{T(c.libelle)}</span></li>
    ))}
  </ul>
</section>

<!-- ═══ 3. INTRO ═══════════════════════════════════════════════════════════ -->
<section class="gc-intro-band gc-reveal">
  <div class="gc-intro-band-inner">
    <h2 class="gc-intro-band-title" set:html={lignes(t.intro.titre)} />
    <div class="gc-intro-band-text gc-mar-paras" set:html={P(t.intro.texte)} />
  </div>
</section>

<!-- ═══ 4. DÉROULÉ : du jour à la nuit ═════════════════════════════════════ -->
<section class="gc-mar-day" aria-labelledby="gc-mar-day-title">
  <div class="gc-sec gc-mar-day-head">
    <div class="gc-sec-head gc-reveal">
      <span class="gc-sec-accroche">{t.deroule.surtitre}</span>
      <h2 id="gc-mar-day-title" class="gc-sec-title">
        {T(t.deroule.titre_blanc)} <span class="gc-mar-gold">{T(t.deroule.titre_or)}</span>
      </h2>
      <p class="gc-body-text" set:html={L(t.deroule.texte)} />
    </div>
  </div>
  <div class="gc-mar-day-flow">
  {moments.map((m, i) => (
    <article class:list={['gc-mar-mo', `gc-mar-mo--${i + 1}`, m.nuit && 'gc-mar-mo--nuit', i % 2 === 1 && 'gc-mar-mo--inv']}>
      <div class="gc-mar-mo-inner gc-reveal">
        <span class="gc-mar-mo-dot" aria-hidden="true"></span>
        <figure class="gc-mar-mo-fig gc-media-hover">
          <Image src={m.img} alt={m.image_alt} widths={[480, 720, 960]} sizes="(min-width: 900px) 24rem, 90vw" loading="lazy" />
        </figure>
        <div class="gc-mar-mo-txt">
          <span class="gc-mar-mo-time">{T(m.heure)}</span>
          <h3 class="gc-mar-mo-title">{T(m.titre)}</h3>
          <div class="gc-mar-mo-copy gc-mar-paras" set:html={P(m.texte)} />
          {m.etiquettes.length > 0 && (
            <ul class="gc-mar-chips">
              {m.etiquettes.map((e) => <li>{T(e)}</li>)}
            </ul>
          )}
          {m.ecoute && estRempli(m.ecoute.lien) && (
            <a class="gc-mar-listen" href={m.ecoute.lien} target="_blank" rel="noopener">
              <span aria-hidden="true" class="gc-mar-listen-ico"></span>{T(m.ecoute.texte)}
            </a>
          )}
          {m.citation && estRempli(m.citation.texte) && (
            <blockquote class="gc-mar-snip">
              <p>«&nbsp;{T(m.citation.texte)}&nbsp;»</p>
              <footer>{T(m.citation.auteur)}</footer>
            </blockquote>
          )}
        </div>
      </div>
    </article>
  ))}
  </div>
  <p class="gc-mar-day-note">{T(t.deroule.note)}</p>
</section>

<!-- ═══ VIDÉO : bandeau pleine largeur (chargée seulement à l'approche) ═══ -->
{t.video && (
  <section class="gc-mar-film" data-film aria-label={B(t.video.description)}>
    <video
      class="gc-mar-film-video"
      muted
      loop
      playsinline
      preload="none"
      poster={VIDEO.affiche}
      data-src-small={VIDEO.petit}
      data-src-large={VIDEO.grand}
      aria-hidden="true"
    ></video>
    <div class="gc-mar-film-bar">
      {t.video.credit_lien
        ? <a class="gc-mar-film-credit" href={t.video.credit_lien} target="_blank" rel="noopener">{T(t.video.credit)}</a>
        : <span class="gc-mar-film-credit">{T(t.video.credit)}</span>}
      <button type="button" class="gc-evt-gal-btn gc-mar-film-btn" data-film-btn aria-pressed="false" aria-label={film.pause} data-label-pause={film.pause} data-label-play={film.lecture}>
        <svg class="gc-mar-film-ico-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <svg class="gc-mar-film-ico-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor" /></svg>
      </button>
    </div>
  </section>
)}

<!-- ═══ 5. AVIS ════════════════════════════════════════════════════════════ -->
<section class="gc-sec gc-sec--tint" id="avis" aria-labelledby="gc-mar-avis-title">
  <div class="gc-sec-inner gc-mar-wide">
    <div class="gc-sec-head gc-reveal">
      <span class="gc-sec-accroche">{t.avis.surtitre}</span>
      <h2 id="gc-mar-avis-title" class="gc-sec-title">
        {T(t.avis.titre_blanc)} <span class="gc-mar-gold">{T(t.avis.titre_or)}</span>
      </h2>
    </div>

    <div class="gc-mar-scores gc-reveal">
      <a class="gc-mar-score" href={lienGoogle} target="_blank" rel="noopener">
        <svg class="gc-mar-score-logo" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
        <span><span class="gc-mar-stars" aria-hidden="true">★★★★★</span><strong>{T(t.avis.google_libelle)}</strong></span>
      </a>

    </div>

    {aLaUne.length > 0 && (
      <div class="gc-mar-feat gc-reveal" data-feat>
        <div class="gc-mar-feat-track">
        {aLaUne.map((a, i) => (
          <figure class:list={['gc-mar-feat-slide', i === 0 && 'is-active', a.texte.length > LONG_UNE && 'is-long']} data-feat-slide aria-hidden={i === 0 ? undefined : 'true'}>
            <div class="gc-mar-feat-img">
              <Image src={a.img} alt="" widths={[400, 700]} sizes="(min-width: 860px) 22rem, 90vw" loading="lazy" />
            </div>
            <div class="gc-mar-feat-q">
              <blockquote set:html={P(a.texte)} />
              <figcaption>
                <strong>{T(a.initiales)}</strong>
                <span>{T(a.date)}</span>
                <span class="gc-mar-stars" aria-label={locale === 'fr' ? '5 étoiles' : '5 stars'}>★★★★★</span>
              </figcaption>
            </div>
          </figure>
        ))}
        </div>
        {aLaUne.length > 1 && (
          <div class="gc-mar-feat-nav">
            <button type="button" class="gc-evt-gal-btn gc-mar-btn-dark" data-feat-prev aria-label={libelles.precedent}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <div class="gc-mar-feat-dots" aria-hidden="true">
              {aLaUne.map((_, i) => <span class:list={[i === 0 && 'is-active']} />)}
            </div>
            <button type="button" class="gc-evt-gal-btn gc-mar-btn-dark" data-feat-next aria-label={libelles.suivant}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
        )}
      </div>
    )}

    {avisListe.length > 0 && (
      <div class="gc-mar-wall">
        {avisListe.map((a) => (
          <article class="gc-mar-rv gc-reveal">
            <div class="gc-mar-rv-top">
              <span class="gc-mar-stars" aria-label={locale === 'fr' ? '5 étoiles' : '5 stars'}>★★★★★</span>
            </div>
            {estRempli(a.titre) && <h3 class="gc-mar-rv-title">{T(a.titre)}</h3>}
            <div class:list={['gc-mar-rv-text gc-mar-paras', a.texte.length > LONG && 'is-long']} data-rv-text set:html={P(a.texte)} />
            {a.texte.length > LONG && (
              <button type="button" class="gc-mar-rv-more" data-rv-more data-less={libelles.moins} aria-expanded="false">{libelles.suite}</button>
            )}
            <footer class="gc-mar-rv-meta">
              <span class="gc-mar-rv-ini" aria-hidden="true">{a.initiales.replace(/[^A-Za-zÀ-ÿ&]/g, '').replace('&', ' & ')}</span>
              <span><strong>{T(a.initiales)}</strong>{T(a.date)}</span>
            </footer>
          </article>
        ))}
      </div>
    )}

    <div class="gc-mar-center gc-reveal">
      <a class="gc-prt-cta" href={lienGoogle} target="_blank" rel="noopener">{T(t.avis.bouton)}</a>
    </div>
  </div>
</section>

<!-- ═══ 6. NOS DJs ═════════════════════════════════════════════════════════ -->
<section class="gc-mar-dark" aria-labelledby="gc-mar-djs-title">
