  }
  .gc-prt-cta::after { content: ''; position: absolute; left: 0; bottom: -3px; width: 100%; height: 1px; background-color: var(--gc-gold); opacity: 0.6; }
  .gc-prt-cta:hover { color: var(--gc-gold); }
  .gc-prt-cta:hover::after { opacity: 1; }

  /* CTA final sur une ligne (identique aux autres pages) */
  .gc-prt-cta-oneline { white-space: nowrap; font-size: clamp(1.45rem, 6.6vw, 4rem); }
  .gc-prt-cta-oneline .gc-final-cta-title-1,
  .gc-prt-cta-oneline .gc-final-cta-title-2 { display: inline-block; }

  /* ══ Barre fixe mobile ═══════════════════════════════════════════════════ */
  .gc-mar-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
    background: #0D0D0DF2;
    border-top: 1px solid #AF945366;
    transform: translateY(110%);
    transition: transform 0.35s ease;
  }
  .gc-mar-bar.is-shown { transform: none; }
  .gc-mar-bar-tel {
    width: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gc-gold);
    color: var(--gc-gold);
  }
  @media (min-width: 900px) { .gc-mar-bar { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .gc-mar-feat-slide { transition: none; }
    .gc-mar-bar { transition: none; }
  }
</style>

<script>
  // Comportements de la page Mariages (aucune bibliothèque externe) :
  // 1) apparitions au scroll (.gc-reveal)  2) « Bien plus qu'un prix » : révélation + compteurs
  // 3) carte : points qui tombent  4) avis à la une  5) « Lire la suite »
  // 6) carrousel infini des lieux  7) barre fixe mobile.
  const observers: IntersectionObserver[] = [];
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const initReveal = () => {
    const els = document.querySelectorAll<HTMLElement>('.gc-reveal');
    const obs = new IntersectionObserver(
      (entries, o) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); o.unobserve(e.target); } }),
      { threshold: 0.1, rootMargin: '0px 0px -25% 0px' }
    );
    els.forEach((el) => obs.observe(el));
    observers.push(obs);
  };

  const formatFr = (n: number) => n.toLocaleString(document.documentElement.lang === 'en' ? 'en-GB' : 'fr-FR');
  const compter = (el: HTMLElement) => {
    const fin = Number(el.dataset.count || 0);
    const texteFinal = el.dataset.final || el.textContent || '';
    if (!fin || reduce()) { el.textContent = texteFinal; return; }
    const duree = 2800;
    const t0 = performance.now();
    const pas = (t: number) => {
      const k = Math.min(1, (t - t0) / duree);
      const v = Math.round(fin * (1 - Math.pow(1 - k, 3)));
      el.textContent = k < 1 ? formatFr(v) : texteFinal;
      if (k < 1) requestAnimationFrame(pas);
    };
    el.textContent = '0';
    requestAnimationFrame(pas);
  };
  const initPlus = () => {
    const rows = document.querySelectorAll<HTMLElement>('[data-plus-row]');
    const obs = new IntersectionObserver(
      (entries, o) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const row = e.target as HTMLElement;
        row.classList.add('is-in');
        row.querySelectorAll<HTMLElement>('[data-count]').forEach(compter);
        o.unobserve(row);
      }),
      { threshold: 0.35, rootMargin: '0px 0px -10% 0px' }
    );
    rows.forEach((r) => obs.observe(r));
    observers.push(obs);
  };

  const initMap = () => {
    const map = document.querySelector<HTMLElement>('[data-map]');
    if (!map) return;
    map.querySelectorAll<SVGGElement>('[data-i]').forEach((g) => g.style.setProperty('--d', `${Number(g.dataset.i) * 70}ms`));
    const obs = new IntersectionObserver(
      (entries, o) => entries.forEach((e) => { if (e.isIntersecting) { map.classList.add('is-visible'); o.disconnect(); } }),
      { threshold: 0.3 }
    );
    obs.observe(map);
    observers.push(obs);
  };

  const initFeat = () => {
    const root = document.querySelector<HTMLElement>('[data-feat]');
    if (!root) return;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-feat-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.gc-mar-feat-dots span'));
    let i = 0;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('is-active', k === i); if (k === i) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };
    root.querySelector<HTMLButtonElement>('[data-feat-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector<HTMLButtonElement>('[data-feat-next]')?.addEventListener('click', () => show(i + 1));
  };

  const initMore = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-rv-more]').forEach((btn) => {
      const txt = btn.previousElementSibling as HTMLElement | null;
      const plus = btn.textContent || '';
      btn.addEventListener('click', () => {
        const open = txt?.classList.toggle('is-open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? btn.dataset.less || plus : plus;
      });
    });
  };

  // Carrousel infini (même fonctionnement que la galerie de la page Événements)
  const AUTO_MS = 4500;
  const initGallery = () => {
    document.querySelectorAll<HTMLElement>('[data-gal]').forEach((root) => {
      if (root.dataset.galReady) return;
      const track = root.querySelector<HTMLElement>('[data-gal-track]');
      const prev = root.querySelector<HTMLButtonElement>('[data-gal-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-gal-next]');
      const pause = root.querySelector<HTMLButtonElement>('[data-gal-pause]');
      if (!track || !prev || !next) return;
      const originals = Array.from(track.children) as HTMLElement[];
      if (originals.length < 3) return;
      root.dataset.galReady = '1';
      const clones = () => originals.map((li) => {
        const c = li.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.setAttribute('inert', '');
        return c;
      });
      track.prepend(...clones());
      track.append(...clones());
      let setW = 0;
      const measure = () => { setW = originals[0].offsetLeft - (track.children[0] as HTMLElement).offsetLeft; };
      const jump = (delta: number) => {
        track.classList.add('is-jumping');
        track.scrollLeft += delta;
        requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('is-jumping')));
      };
      const recentre = () => { if (track.scrollLeft < setW * 0.5) jump(setW); else if (track.scrollLeft > setW * 1.5) jump(-setW); };
      const step = () => originals[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '16');
      const reset = () => { measure(); track.classList.add('is-jumping'); track.scrollLeft = setW; requestAnimationFrame(() => track.classList.remove('is-jumping')); };
      reset();
      let timer: number | undefined;
      track.addEventListener('scroll', () => { window.clearTimeout(timer); timer = window.setTimeout(recentre, 120); }, { passive: true });
      window.addEventListener('resize', reset);
      const go = (dir: 1 | -1) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });

      let auto: number | undefined;
      let paused = reduce();
      let keyboard = false;
      let visible = false;
      function refresh() {
        window.clearInterval(auto);
        auto = undefined;
        if (paused || keyboard || !visible) return;
        auto = window.setInterval(() => go(1), AUTO_MS);
      }
      const setPaused = (v: boolean) => {
        paused = v;
        if (pause) {
          pause.setAttribute('aria-pressed', String(v));
          pause.setAttribute('aria-label', (v ? pause.dataset.labelPlay : pause.dataset.labelPause) || '');
        }
        refresh();
      };
      // Clic sur une flèche : on avance, et le défilement auto repart de zéro (il ne s'arrête pas).
      prev.onclick = () => { go(-1); refresh(); };
      next.onclick = () => { go(1); refresh(); };
      if (pause) {
        root.classList.add('is-auto');
        setPaused(paused);
        pause.onclick = () => setPaused(!paused);
        // Pas de pause au survol (le carrousel occupe toute la largeur) : pause = bouton ou clavier.
        track.addEventListener('focus', () => { keyboard = track.matches(':focus-visible'); refresh(); });
        track.addEventListener('blur', () => { keyboard = false; refresh(); });
        track.addEventListener('touchstart', () => refresh(), { passive: true });
        const o = new IntersectionObserver((e) => { visible = e[0].isIntersecting; refresh(); }, { threshold: 0.4 });
        o.observe(root);
        observers.push(o);
      }
    });
  };

  // Barre mobile : visible après le hero, masquée sur le CTA final et le pied de page
  const initBar = () => {
    const bar = document.querySelector<HTMLElement>('[data-mar-bar]');
    const hero = document.querySelector<HTMLElement>('[data-mar-hero]');
    if (!bar || !hero) return;
    const fins = [document.querySelector('[data-mar-cta]'), document.querySelector('footer')].filter(Boolean) as Element[];
    let heroVu = true;
    let finVue = false;
    const maj = () => bar.classList.toggle('is-shown', !heroVu && !finVue);
    const oHero = new IntersectionObserver((e) => { heroVu = e[0].isIntersecting; maj(); });
    oHero.observe(hero);
    const etats = new Map<Element, boolean>();
    const oFin = new IntersectionObserver((entries) => {
      entries.forEach((e) => etats.set(e.target, e.isIntersecting));
      finVue = [...etats.values()].some(Boolean);
      maj();
    });
    fins.forEach((f) => oFin.observe(f));
    observers.push(oHero, oFin);
  };

  // Vidéo : chargée seulement à l'approche, jouée uniquement quand elle est à l'écran.
  // Si le visiteur a demandé « moins d'animations » ou « économie de données », elle reste
  // sur l'image d'affiche : le bouton lecture permet de la lancer.
  const initFilm = () => {
    const root = document.querySelector<HTMLElement>('[data-film]');
    const video = root?.querySelector<HTMLVideoElement>('video');
    const btn = root?.querySelector<HTMLButtonElement>('[data-film-btn]');
    if (!root || !video || !btn || root.dataset.filmReady) return;
    root.dataset.filmReady = '1';
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    let paused = reduce() || saveData;
    let visible = false;
    const load = () => {
      if (video.getAttribute('src')) return;
      const large = window.matchMedia('(min-width: 768px)').matches;
      video.src = (large ? video.dataset.srcLarge : video.dataset.srcSmall) || '';
    };
    const sync = () => {
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', (paused ? btn.dataset.labelPlay : btn.dataset.labelPause) || '');
      if (!paused && visible) { load(); video.play().catch(() => undefined); } else video.pause();
    };
    btn.onclick = () => { paused = !paused; sync(); };
    // Préchargement un peu avant l'arrivée à l'écran
    const pre = new IntersectionObserver((e) => { if (e[0].isIntersecting && !paused) { load(); pre.disconnect(); } }, { rootMargin: '400px 0px' });
    pre.observe(root);
    const vis = new IntersectionObserver((e) => { visible = e[0].isIntersecting; sync(); }, { threshold: 0.25 });
    vis.observe(root);
    observers.push(pre, vis);
    sync();
  };

  const init = () => {
    observers.splice(0).forEach((o) => o.disconnect());
    document.documentElement.classList.add('gc-js');
    initReveal();
    initPlus();
    initMap();
    initFeat();
    initMore();
    initGallery();
    initFilm();
    initBar();
  };
  document.addEventListener('astro:page-load', init);
</script>
