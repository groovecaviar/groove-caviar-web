<style>
  /* Couleurs : variables de palette (tailwind.css) — --gc-surface #FFFFFF ·
     --gc-surface-alt #F2F2F2 · --gc-ink #0D0D0D · --gc-gold #AF9453 — et hex 8 chiffres. */

  .gc-mar-gold { color: var(--gc-gold); }
  .gc-mar-wide { max-width: 72rem; }
  .gc-mar-head-wide { max-width: 60rem; }
  .gc-mar-paras :global(p) { margin-bottom: 1rem; }
  .gc-mar-paras :global(p:last-child) { margin-bottom: 0; }
  .gc-mar-accent-safe { display: inline-block; padding-top: 0.2em; margin-top: -0.2em; }
  .gc-mar-stars { color: var(--gc-gold); letter-spacing: 0.12em; }
  .gc-mar-center { text-align: center; margin-top: 2.5rem; }
  .gc-mar-center .gc-prt-cta { margin-inline: auto; }

  /* ══ 2. CHIFFRES ═════════════════════════════════════════════════════════ */
  .gc-mar-stats { background: var(--gc-ink); color: #FFFFFF; border-top: 1px solid #FFFFFF1A; }
  .gc-mar-stats-list {
    list-style: none;
    margin: 0 auto;
    padding: 2.75rem 1.25rem;
    max-width: 64rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
    text-align: center;
  }
  .gc-mar-stats-list strong {
    display: block;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--gc-gold);
  }
  .gc-mar-stats-list span {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFFFFFB3;
  }
  @media (min-width: 900px) { .gc-mar-stats-list { grid-template-columns: repeat(4, 1fr); } }

  /* ══ 4. DÉROULÉ : chaque moment porte sa portion du dégradé jour → nuit ══ */
  /* Un seul dégradé continu jour → nuit sur l'ensemble des moments.
     Réglé pour 6 moments : la bascule vers la nuit se fait entre le 3e et le 4e. */
  .gc-mar-day-head { background: #FFFFFF; padding-bottom: 2rem; }
  .gc-mar-day-flow {
    background: linear-gradient(
      180deg,
      #FFFFFF 0%, #FDFBF7 12%, #F9F4EB 22%, #F3EBDC 31%, #EBDFC8 38%,
      #E0CFB0 43%, #CDB78F 46.5%, #AC946C 49%, #7F6B4E 51.5%, #554837 54%,
      #362E25 57%, #231E19 61%, #171513 67%, #111010 75%, #0D0D0D 85%, #0D0D0D 100%
    );
  }
  .gc-mar-mo { position: relative; color: var(--gc-ink); padding: 2.5rem 1.25rem; }
  .gc-mar-mo--nuit { color: #FFFFFF; }
  /* Ligne du temps continue (dessinée par chaque moment) */
  .gc-mar-mo::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2.3rem;
    width: 1px;
    background: var(--gc-gold);
  }
  .gc-mar-mo-inner {
    position: relative;
    max-width: 64rem;
    margin-inline: auto;
    display: grid;
    gap: 1.5rem;
    padding-left: 2.5rem;
  }
  .gc-mar-mo-dot {
    position: absolute;
    left: 0.55rem;
    top: 0.4rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--gc-gold);
    box-shadow: 0 0 0 6px #AF945333;
  }
  .gc-mar-mo-fig { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; max-width: 24rem; }
  .gc-mar-mo-fig :global(img) { display: block; }
  .gc-mar-mo-fig :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .gc-mar-mo-time {
    display: block;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gc-gold);
  }
  .gc-mar-mo-title {
    margin: 0.4rem 0 0.9rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.05;
  }
  .gc-mar-mo-copy { font-size: 0.95rem; line-height: 1.7; max-width: 32rem; }
  .gc-mar-mo--nuit .gc-mar-mo-copy { color: #FFFFFFD9; }
  .gc-mar-chips { list-style: none; margin: 1.1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .gc-mar-chips li {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gc-gold);
    border: 1px solid var(--gc-gold);
    padding: 0.55rem 0.8rem;
  }
  .gc-mar-listen {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.2rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: inherit;
    border-bottom: 1px solid var(--gc-gold);
    padding-bottom: 0.35rem;
  }
  .gc-mar-listen:hover { color: var(--gc-gold); }
  .gc-mar-listen-ico { width: 0; height: 0; border-left: 7px solid currentColor; border-top: 5px solid transparent; border-bottom: 5px solid transparent; }
  .gc-mar-snip { margin: 1.5rem 0 0; padding-left: 1rem; border-left: 2px solid var(--gc-gold); }
  .gc-mar-snip p {
    margin: 0;
    font-family: var(--font-quote, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.35;
  }
  .gc-mar-snip footer { margin-top: 0.4rem; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.7; }
  .gc-mar-day-note { margin: 0; padding: 0 1.25rem 4rem; background: #0D0D0D; text-align: center; font-size: 0.78rem; color: #FFFFFF80; }

  @media (min-width: 900px) {
    .gc-mar-mo { padding: 3.5rem 1.25rem; }
    .gc-mar-mo::before { left: 50%; }
    .gc-mar-mo-inner { grid-template-columns: 1fr 1fr; gap: 5rem; padding-left: 0; align-items: center; }
    .gc-mar-mo-dot { left: calc(50% - 0.5rem); top: 50%; }
    .gc-mar-mo-fig { justify-self: end; width: 100%; }
    .gc-mar-mo--inv .gc-mar-mo-fig { order: 2; justify-self: start; }
    .gc-mar-mo--inv .gc-mar-mo-txt { text-align: right; justify-self: end; }
    .gc-mar-mo--inv .gc-mar-mo-copy { margin-left: auto; }
    .gc-mar-mo--inv .gc-mar-chips { justify-content: flex-end; }
    .gc-mar-mo--inv .gc-mar-snip { border-left: 0; border-right: 2px solid var(--gc-gold); padding: 0 1rem 0 0; }
  }

  /* ══ 5. AVIS ═════════════════════════════════════════════════════════════ */
  .gc-mar-scores { display: grid; gap: 1rem; max-width: 52rem; margin: 0 auto 3rem; }
  .gc-mar-score {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.3rem 1.5rem;
    background: var(--gc-surface);
    border: 1px solid #0D0D0D1A;
    transition: border-color 0.25s ease;
  }
  .gc-mar-score:hover { border-color: var(--gc-gold); }
  .gc-mar-score-logo { width: 2rem; height: 2rem; flex: none; }
  .gc-mar-score strong { display: block; margin-top: 0.15rem; font-size: 0.95rem; color: var(--gc-ink); }
  .gc-mar-scores { max-width: 26rem; }

  .gc-mar-feat { position: relative; max-width: 62rem; margin: 0 auto 3.5rem; background: var(--gc-ink); color: #FFFFFF; }
  /* Toutes les diapositives occupent la même case : la hauteur reste celle de l'avis le plus long
     (pas de saut de page quand on change d'avis). */
  .gc-mar-feat-track { display: grid; }
  .gc-mar-feat-slide {
    grid-area: 1 / 1;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s;
  }
  .gc-mar-feat-slide.is-active { opacity: 1; visibility: visible; }
  .gc-mar-feat-img { aspect-ratio: 1; overflow: hidden; }
  .gc-mar-feat-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .gc-mar-feat-q { padding: 2rem 1.75rem 2.25rem; }
  .gc-mar-feat-q blockquote { margin: 0; }
  .gc-mar-feat-q blockquote::before {
    content: '“';
    display: block;
    font-family: var(--font-quote, 'Cormorant Garamond', serif);
    font-size: 4.5rem;
    line-height: 0.6;
    color: var(--gc-gold);
    margin-bottom: 0.6rem;
  }
  .gc-mar-feat-q blockquote :global(p) {
    margin: 0 0 0.8rem;
    font-family: var(--font-quote, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: clamp(1.25rem, 2.3vw, 1.7rem);
    line-height: 1.35;
  }
  .gc-mar-feat-slide.is-long blockquote :global(p) { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.45; }
  .gc-mar-feat-q figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: 1.25rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .gc-mar-feat-q figcaption strong { color: var(--gc-gold); font-size: 0.95rem; white-space: nowrap; }
  .gc-mar-feat-nav { display: flex; align-items: center; gap: 1rem; padding: 0 1.75rem 2rem; }
  .gc-mar-feat-nav .gc-evt-gal-btn { flex: none; }
  .gc-mar-feat-dots { display: flex; gap: 0.5rem; min-width: 0; }
  .gc-mar-feat-dots span { width: 2rem; min-width: 0.9rem; flex-shrink: 1; height: 2px; background: #FFFFFF4D; transition: background-color 0.3s ease; }
  .gc-mar-feat-dots span.is-active { background: var(--gc-gold); }
  @media (min-width: 860px) {
    .gc-mar-feat-slide { grid-template-columns: 22rem 1fr; gap: 3rem; align-items: center; }
    .gc-mar-feat-q { padding: 2.5rem 3rem 2.5rem 0; }
    .gc-mar-feat-nav { justify-content: flex-end; padding: 0 3rem 2.25rem; }
  }

  .gc-mar-wall { columns: 1; column-gap: 1.25rem; }
  @media (min-width: 700px) { .gc-mar-wall { columns: 2; } }
  @media (min-width: 1050px) { .gc-mar-wall { columns: 3; } }
  .gc-mar-rv { break-inside: avoid; background: var(--gc-surface); border: 1px solid #0D0D0D1A; padding: 1.5rem 1.5rem 1.3rem; margin: 0 0 1.25rem; }
  .gc-mar-rv-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .gc-mar-rv-src { font-size: 0.65rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.55; }
  .gc-mar-rv-title {
    margin: 0 0 0.5rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .gc-mar-rv-text { font-size: 0.9rem; line-height: 1.65; }
  .gc-mar-rv-text.is-long:not(.is-open) {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .gc-mar-rv-more {
    margin-top: 0.6rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gc-gold);
  }
  .gc-mar-rv-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid #0D0D0D1A;
    font-size: 0.76rem;
    color: #0D0D0D99;
  }
  .gc-mar-rv-meta strong { display: block; color: var(--gc-ink); font-size: 0.82rem; }
  .gc-mar-rv-ini {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--gc-ink);
    color: var(--gc-gold);
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }

  /* ══ Sections sombres (DJs, Bien plus qu'un prix) ════════════════════════ */
  .gc-mar-dark { background: var(--gc-ink); color: #FFFFFF; padding: clamp(4rem, 9vh, 6.5rem) 1.25rem; }
  .gc-mar-on-dark { color: #FFFFFF; }
  .gc-mar-soft { color: #FFFFFFC7; }

  /* ══ 6. DJs ══════════════════════════════════════════════════════════════ */
  .gc-mar-djs { list-style: none; margin: 0; padding: 0; display: grid; gap: 3rem 2rem; }
  .gc-mar-dj-fig { margin: 0 0 1.25rem; aspect-ratio: 4 / 5; overflow: hidden; }
  .gc-mar-dj-fig :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter 0.8s ease; }
  @media (hover: hover) { .gc-mar-dj:hover .gc-mar-dj-fig :global(img) { filter: grayscale(0); } }
  @media (hover: none) { .gc-mar-dj-fig :global(img) { filter: grayscale(0); } }
  .gc-mar-dj-role {
    display: block;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gc-gold);
  }
  .gc-mar-dj-name {
    margin: 0.35rem 0 0.5rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .gc-mar-dj-lang {
    display: inline-block;
    margin-bottom: 0.9rem;
    border: 1px solid #FFFFFF4D;
    padding: 0.4rem 0.65rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .gc-mar-promise {
    margin: 3.5rem auto 0;
    max-width: 48rem;
    padding: 1.3rem 1.5rem;
    border: 1px solid #AF945366;
    text-align: center;
    font-size: 0.9rem;
    color: #FFFFFFD9;
  }
  .gc-mar-promise strong {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--aw-font-heading, sans-serif);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gc-gold);
  }
  @media (min-width: 760px) { .gc-mar-djs { grid-template-columns: repeat(3, 1fr); } }

  /* ══ 7. MÉTHODE ══════════════════════════════════════════════════════════ */
  .gc-mar-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.5rem 2rem; }
  .gc-mar-steps li { padding-top: 1.4rem; border-top: 1px solid var(--gc-gold); }
  .gc-mar-step-num { font-family: var(--aw-font-heading, sans-serif); font-size: 2.4rem; font-weight: 700; line-height: 1; color: var(--gc-gold); }
  .gc-mar-step-title {
    margin: 0.8rem 0 0.5rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  @media (min-width: 700px) { .gc-mar-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .gc-mar-steps { grid-template-columns: repeat(3, 1fr); } }

  /* ══ 8. BIEN PLUS QU'UN PRIX : révélation en deux temps + compteurs ══════ */
  .gc-mar-plus-list { list-style: none; margin: 0 auto; padding: 0; max-width: 52rem; }
  .gc-mar-plus-row {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0 1rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid #FFFFFF14;
  }
  .gc-mar-plus-num {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--gc-gold);
    padding-top: 0.45rem;
  }
  .gc-mar-plus-title {
    margin: 0;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
    color: #FFFFFF;
  }
  .gc-mar-plus-count { color: var(--gc-gold); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gc-mar-plus-line {
    display: block;
    height: 1px;
    width: 6rem;
    margin: 0.9rem 0 0.7rem;
    background: var(--gc-gold);
  }
  .gc-mar-plus-detail {
    margin: 0;
    font-family: var(--font-quote, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.35;
    color: var(--gc-gold);
  }
  /* État initial (seulement si JavaScript actif et animations autorisées) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.gc-js) .gc-mar-plus-title { opacity: 0; transform: translateY(26px); transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
    :global(.gc-js) .gc-mar-plus-line { transform: scaleX(0); transform-origin: left; transition: transform 0.9s cubic-bezier(0.25, 1, 0.5, 1) 0.35s; }
    :global(.gc-js) .gc-mar-plus-detail { clip-path: inset(0 100% 0 0); transition: clip-path 1.1s cubic-bezier(0.25, 1, 0.5, 1) 0.6s; }
    :global(.gc-js) .gc-mar-plus-num { opacity: 0; transition: opacity 0.6s ease; }
    .gc-mar-plus-row.is-in .gc-mar-plus-title { opacity: 1; transform: none; }
    .gc-mar-plus-row.is-in .gc-mar-plus-line { transform: scaleX(1); }
    .gc-mar-plus-row.is-in .gc-mar-plus-detail { clip-path: inset(0 0 0 0); }
    .gc-mar-plus-row.is-in .gc-mar-plus-num { opacity: 1; }
  }

  /* ══ 9. TARIFS & OPTIONS ═════════════════════════════════════════════════ */
  /* Carte « carton d'invitation » : fond blanc, double filet doré */
  .gc-mar-price {
    position: relative;
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    background: #FFFFFF;
    text-align: center;
    outline: 1px solid var(--gc-gold);
    outline-offset: -10px;
  }
  .gc-mar-price::before {
    content: '';
    position: absolute;
    inset: 15px;
    border: 1px solid #AF945359;
    pointer-events: none;
  }
  .gc-mar-price-name {
    margin: 0;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gc-gold);
  }
  .gc-mar-price-from {
    display: block;
    margin: 1.6rem 0 0.3rem;
    font-family: var(--aw-font-serif, serif);
    font-style: italic;
    font-size: 1.45rem;
    line-height: 1;
  }
  .gc-mar-price-amt {
    display: block;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(3rem, 9vw, 4.2rem);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .gc-mar-price-season { margin: 0.9rem 0 0; font-size: 0.9rem; color: #0D0D0DA6; }
  .gc-mar-price-orn { display: block; width: 7rem; height: 1px; margin: 2rem auto; background: var(--gc-gold); }
  .gc-mar-price-list { list-style: none; max-width: 36rem; margin: 0 auto 1.5rem; padding: 0; text-align: left; }
  .gc-mar-price-list li { position: relative; break-inside: avoid; padding: 0.45rem 0 0.45rem 1.4rem; font-size: 0.92rem; line-height: 1.45; }
  .gc-mar-price-list li::before { content: '✦'; position: absolute; left: 0; top: 0.5rem; font-size: 0.75rem; color: var(--gc-gold); }
  .gc-mar-price-note { max-width: 32rem; margin: 0 auto 2rem; font-size: 0.82rem; font-style: italic; color: #0D0D0DA6; }

  /* Options : 4 colonnes séparées par des filets, titres en Cormorant doré */
  .gc-mar-opts-head { max-width: 40rem; margin: 4rem auto 1.5rem; text-align: center; }
  .gc-mar-opts-head .gc-mar-sub { margin-bottom: 0.75rem; }
  .gc-mar-opts { display: grid; max-width: 60rem; margin: 0 auto; border-top: 1px solid #0D0D0D26; }
  .gc-mar-opt { padding: 1.5rem 1.25rem; border-bottom: 1px solid #0D0D0D1A; }
  .gc-mar-opt-title {
    margin: 0 0 0.8rem;
    font-family: var(--aw-font-serif, serif);
    font-style: italic;
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.1;
    color: var(--gc-gold);
  }
  .gc-mar-opt ul { list-style: none; margin: 0; padding: 0; }
  .gc-mar-opt li { padding: 0.2rem 0; font-size: 0.88rem; line-height: 1.55; color: #0D0D0DCC; }
  @media (min-width: 640px) {
    .gc-mar-price { padding: 3.5rem 3rem; outline-offset: -14px; }
    .gc-mar-price::before { inset: 20px; }
    .gc-mar-price-list { columns: 2; column-gap: 2.5rem; }
    .gc-mar-opts { grid-template-columns: 1fr 1fr; }
    .gc-mar-opt:nth-child(odd) { border-right: 1px solid #0D0D0D1A; }
  }
  @media (min-width: 1000px) {
    .gc-mar-opts { grid-template-columns: repeat(4, 1fr); }
    .gc-mar-opt { border-bottom: 0; border-right: 1px solid #0D0D0D1A; }
    .gc-mar-opt:last-child { border-right: 0; }
  }

  /* ══ VIDÉO : bandeau pleine largeur ══════════════════════════════════════ */
  .gc-mar-film { position: relative; background: var(--gc-ink); }
  .gc-mar-film-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 85vh;
    object-fit: cover;
    background: var(--gc-ink);
  }
  .gc-mar-film-bar {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2.5rem 1.25rem 1rem;
    background: linear-gradient(to top, #0D0D0DB3 0%, #0D0D0D00 100%);
  }
  .gc-mar-film-credit {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FFFFFFCC;
    text-decoration: none;
  }
  a.gc-mar-film-credit:hover { color: var(--gc-gold); }
  .gc-mar-film .gc-mar-film-btn { flex: none; border-color: #FFFFFFB3; color: #FFFFFF; }
  .gc-mar-film-ico-play { display: none; }
  .gc-mar-film-btn[aria-pressed='true'] .gc-mar-film-ico-pause { display: none; }
  .gc-mar-film-btn[aria-pressed='true'] .gc-mar-film-ico-play { display: block; }
  @media (min-width: 768px) { .gc-mar-film-bar { padding: 3rem 2.5rem 1.5rem; } }

  /* ══ 10. LOCALISATION : carte stylisée + zones ═══════════════════════════ */
  .gc-mar-geo { display: grid; gap: 2.5rem; align-items: start; margin-bottom: 4rem; }
  .gc-mar-map { margin: 0; background: var(--gc-ink); padding: 1rem 1rem 1.25rem; }
  .gc-mar-map svg { display: block; width: 100%; height: auto; }
  .gc-mar-map figcaption { margin-top: 0.75rem; text-align: center; font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: #FFFFFF99; }
  .gc-mar-map-sea { fill: #0D0D0D; }
  .gc-mar-map-land { fill: #1C1913; }
  .gc-mar-map-coast { fill: none; stroke: #AF9453; stroke-width: 1.4; }
  .gc-mar-map-border { fill: none; stroke: #FFFFFF40; stroke-width: 1; stroke-dasharray: 4 5; }
  .gc-mar-map-river { fill: none; stroke: #AF945359; stroke-width: 1; }
  .gc-mar-map-sea-label { fill: #AF945399; font-family: var(--font-quote, 'Cormorant Garamond', serif); font-style: italic; font-size: 20px; letter-spacing: 0.08em; }
  .gc-mar-map-region { fill: #FFFFFF59; font-family: var(--aw-font-heading, sans-serif); font-size: 12px; font-weight: 700; letter-spacing: 0.3em; text-transform: uppercase; }
  .gc-mar-map-city circle { fill: #FFFFFFB3; }
  .gc-mar-map-city text { fill: #FFFFFFCC; font-family: var(--aw-font-heading, sans-serif); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; }
  .gc-mar-map-dot { fill: var(--gc-gold); stroke: #0D0D0D; stroke-width: 1.2; cursor: help; }
  .gc-mar-map-pt { --d: 0ms; }
  .gc-mar-map-halo { fill: #AF945340; transform-box: fill-box; transform-origin: center; }
  .gc-mar-map-world path { fill: none; stroke: var(--gc-gold); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .gc-mar-map-world text { fill: var(--gc-gold); font-family: var(--aw-font-heading, sans-serif); font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.gc-js) .gc-mar-map-pt { opacity: 0; transform: translateY(-14px); transition: opacity 0.6s ease var(--d), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d); }
    .gc-mar-map.is-visible .gc-mar-map-pt { opacity: 1; transform: none; }
    .gc-mar-map.is-visible .gc-mar-map-halo { animation: gc-mar-pulse 2.8s ease-out infinite; animation-delay: calc(var(--d) + 0.6s); }
  }
  @keyframes gc-mar-pulse { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(2.2); opacity: 0; } }

  .gc-mar-sub {
    margin: 0 0 1.25rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.85rem;
