  }

  /* ══ 11. À CHAQUE COUPLE SA BANDE-SON ════════════════════════════════════ */
  .gc-mar-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .gc-mar-card { padding: 2rem 1.75rem 1.75rem; }
  @media (min-width: 700px) { .gc-mar-cards { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .gc-mar-cards { grid-template-columns: repeat(4, 1fr); } }

  .gc-mar-badges { margin-top: 3.5rem; }
  .gc-mar-badges ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.5rem 2.5rem; }
  .gc-mar-badges :global(img) { display: block; height: 6.5rem; width: auto; }

  /* ══ Carrousel des lieux : mêmes classes que la galerie de la page Événements ══ */
  .gc-evt-gal { padding-bottom: 0; }
  .gc-evt-gal-wrap { max-width: 90rem; margin: 0 auto; }
  .gc-evt-gal-track {
    list-style: none;
    margin: 0;
    padding: 0 1rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .gc-evt-gal-track::-webkit-scrollbar { display: none; }
  .gc-evt-gal-track:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) { .gc-evt-gal-track { scroll-behavior: smooth; } }
  .gc-evt-gal-item { flex: 0 0 70%; scroll-snap-align: start; }
  .gc-evt-gal-fig { margin: 0; }
  .gc-mar-venue-img { overflow: hidden; }
  .gc-evt-gal-fig :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background-color: var(--gc-surface-alt); }
  .gc-evt-gal-fig figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-quote, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.3;
    color: #0D0D0DA6;
  }
  .gc-evt-gal-nav { display: flex; justify-content: center; gap: 0.75rem; margin-top: 2rem; }
  .gc-evt-gal-btn {
    width: 2.9rem;
    height: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gc-ink);
    border-radius: 9999px;
    background: transparent;
    color: var(--gc-ink);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  }
  .gc-evt-gal-btn:hover:not(:disabled) { background: var(--gc-gold); border-color: var(--gc-gold); color: var(--gc-ink); }
  .gc-evt-gal-btn:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 3px; }
  .gc-evt-gal-btn--pause { display: none; }
  [data-gal].is-auto .gc-evt-gal-btn--pause { display: inline-flex; }
  .gc-evt-gal-ico-play { display: none; }
  .gc-evt-gal-btn--pause[aria-pressed='true'] .gc-evt-gal-ico-pause { display: none; }
  .gc-evt-gal-btn--pause[aria-pressed='true'] .gc-evt-gal-ico-play { display: block; }
  .gc-evt-gal-track.is-jumping { scroll-snap-type: none; scroll-behavior: auto; }
  .gc-mar-btn-dark { border-color: #FFFFFF66; color: #FFFFFF; }
  @media (min-width: 768px) {
    .gc-evt-gal-track { padding-inline: 2rem; scroll-padding-inline: 2rem; gap: 1.25rem; }
    .gc-evt-gal-item { flex-basis: 36%; }
  }
  @media (min-width: 1024px) {
    .gc-evt-gal-track { padding-inline: max(2rem, calc((100% - 72rem) / 2)); scroll-padding-inline: max(2rem, calc((100% - 72rem) / 2)); gap: 1.5rem; }
    .gc-evt-gal-item { flex-basis: 23%; }
  }

  /* ══ FAQ (identique à Soirées / Événements) ══════════════════════════════ */
  .gc-prt-faq-inner { max-width: 50rem; }
  .gc-prt-faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .gc-prt-faq-item { background: var(--gc-surface); border-radius: 0.65rem; padding: 1.15rem 1.4rem; transition: background-color 0.3s ease; }
  .gc-prt-faq-item[open] { background: #AF945314; }
  .gc-prt-faq-item summary { display: flex; align-items: baseline; gap: 0.9rem; cursor: pointer; list-style: none; }
  .gc-prt-faq-item summary::-webkit-details-marker { display: none; }
  .gc-prt-faq-q { flex: 1; margin: 0; font-size: 0.95rem; font-weight: 700; line-height: 1.4; color: var(--gc-ink); }
  .gc-prt-faq-icon { position: relative; flex-shrink: 0; width: 0.8rem; height: 0.8rem; align-self: center; }
  .gc-prt-faq-icon::before,
  .gc-prt-faq-icon::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 1.5px; background: var(--gc-gold); transition: transform 0.3s ease; }
  .gc-prt-faq-icon::after { transform: rotate(90deg); }
  .gc-prt-faq-item[open] .gc-prt-faq-icon::after { transform: rotate(0deg); }
  .gc-prt-faq-a { margin: 0.85rem 0 0; padding-left: 2.05rem; color: var(--gc-ink); }
  .gc-prt-faq-a :global(p) { opacity: 0.88; }

  /* Liens « Découvrir / Lire nos avis » (identiques à Soirées / Événements) */
  .gc-prt-cta {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    position: relative;
    font-family: var(--aw-font-heading, sans-serif);
