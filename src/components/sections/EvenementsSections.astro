  }
  /* Icône + / − */
  .gc-prt-faq-icon {
    position: relative;
    flex-shrink: 0;
    width: 0.8rem;
    height: 0.8rem;
    align-self: center;
  }
  .gc-prt-faq-icon::before,
  .gc-prt-faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--gc-gold);
    transition: transform 0.3s ease;
  }
  .gc-prt-faq-icon::after { transform: rotate(90deg); }
  .gc-prt-faq-item[open] .gc-prt-faq-icon::after { transform: rotate(0deg); }
  .gc-prt-faq-a { margin: 0.85rem 0 0; padding-left: 2.05rem; color: var(--gc-ink); }
  .gc-prt-faq-a :global(p) { opacity: 0.88; }

  /* ══ CTA final : une seule ligne ═════════════════════════════════════════ */
  .gc-prt-cta-oneline {
    white-space: nowrap;
    font-size: clamp(1.45rem, 6.6vw, 4rem);
  }
  .gc-prt-cta-oneline .gc-final-cta-title-1,
  .gc-prt-cta-oneline .gc-final-cta-title-2 { display: inline-block; }

  @media (prefers-reduced-motion: reduce) {
    .gc-evt-shot,
    .gc-evt-item { transition: none; }
  }
  /* ── Mur de logos clients (monochrome, apparition en cascade) ───────── */
  .gc-evt-logos {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 76rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gc-evt-logo {
    width: 50%;
    height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .gc-evt-clients.is-visible .gc-evt-logo { opacity: 0.6; transform: none; }
  /* Cascade : le retard dépend de la position dans la rangée */
  .gc-evt-logo:nth-child(6n + 2) { transition-delay: 70ms; }
  .gc-evt-logo:nth-child(6n + 3) { transition-delay: 140ms; }
  .gc-evt-logo:nth-child(6n + 4) { transition-delay: 210ms; }
  .gc-evt-logo:nth-child(6n + 5) { transition-delay: 280ms; }
  .gc-evt-logo:nth-child(6n + 6) { transition-delay: 350ms; }
  .gc-evt-clients.is-visible .gc-evt-logo:hover { opacity: 1; transition-delay: 0s; transition-duration: 0.25s; }
  .gc-evt-logo :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 3.1rem;
    object-fit: contain;
  }
  /* Logos étroits / verticaux : plus hauts pour le même poids visuel */
  .gc-evt-logo--tall :global(img) { max-height: 4.4rem; }
  @media (min-width: 640px) {
    .gc-evt-logo { width: 33.333%; }
  }
  @media (min-width: 1024px) {
    .gc-evt-logo { width: 16.666%; height: 6.5rem; padding: 0 1rem; }
    .gc-evt-logo :global(img) { max-height: 3.6rem; }
    .gc-evt-logo--tall :global(img) { max-height: 5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gc-evt-logo { opacity: 0.6; transform: none; transition: none; }
  }

  /* ── Galerie : carrousel à glissement (scroll-snap, sans bibliothèque) ── */
  .gc-evt-gal { padding-bottom: 4rem; }
  .gc-evt-gal-wrap { max-width: 90rem; margin: 0 auto; }
  .gc-evt-gal-track {
    list-style: none;
    margin: 0;
    padding: 0 1rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .gc-evt-gal-track::-webkit-scrollbar { display: none; }
  .gc-evt-gal-track:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .gc-evt-gal-track { scroll-behavior: smooth; }
  }
  .gc-evt-gal-item { flex: 0 0 80%; scroll-snap-align: start; }
  .gc-evt-gal-fig { margin: 0; }
  .gc-evt-gal-fig :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background-color: var(--gc-surface-alt);
  }
  .gc-evt-gal-fig figcaption {
    margin-top: 0.75rem;
    font-family: var(--aw-font-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--gc-ink);
  }
  .gc-evt-gal-nav { display: flex; justify-content: center; gap: 0.75rem; margin-top: 2rem; }
  .gc-evt-gal-btn {
    width: 2.9rem;
    height: 2.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--gc-ink);
    border-radius: 9999px;
    background: transparent;
    color: var(--gc-ink);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, opacity 0.25s ease;
  }
  .gc-evt-gal-btn:hover:not(:disabled) { background: var(--gc-gold); border-color: var(--gc-gold); color: var(--gc-ink); }
  .gc-evt-gal-btn:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 3px; }
  .gc-evt-gal-btn:disabled { opacity: 0.3; cursor: default; }
  /* Bouton pause / lecture : visible seulement quand le défilement automatique est actif */
  .gc-evt-gal-btn--pause { display: none; }
  [data-gal].is-auto .gc-evt-gal-btn--pause { display: inline-flex; }
  .gc-evt-gal-ico-play { display: none; }
  .gc-evt-gal-btn--pause[aria-pressed='true'] .gc-evt-gal-ico-pause { display: none; }
  .gc-evt-gal-btn--pause[aria-pressed='true'] .gc-evt-gal-ico-play { display: block; }
  /* Saut invisible du carrousel infini : pas d'accroche ni d'animation pendant le repositionnement */
  .gc-evt-gal-track.is-jumping { scroll-snap-type: none; scroll-behavior: auto; }
  @media (min-width: 768px) {
    .gc-evt-gal-track { padding-inline: 2rem; scroll-padding-inline: 2rem; gap: 1.25rem; }
    .gc-evt-gal-item { flex-basis: 44%; }
  }
  @media (min-width: 1024px) {
    .gc-evt-gal-track { padding-inline: max(2rem, calc((100% - 80rem) / 2)); scroll-padding-inline: max(2rem, calc((100% - 80rem) / 2)); gap: 1.5rem; }
    .gc-evt-gal-item { flex-basis: 30%; }
  }
</style>

<script>
  // 1) Apparition au scroll des blocs .gc-reveal (même réglage que Services).
  // 2) Image fixe : l'événement lu (au milieu de l'écran) active l'image correspondante.
  let revealObserver: IntersectionObserver | null = null;
  let activeObserver: IntersectionObserver | null = null;

  const initReveal = () => {
    revealObserver?.disconnect();
    const revealEls = document.querySelectorAll<HTMLElement>('.gc-reveal');
    if (!revealEls.length) return;
    revealObserver = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -25% 0px' }
    );
    revealEls.forEach((el) => revealObserver!.observe(el));
  };

  const initActive = () => {
    activeObserver?.disconnect();
    const root = document.querySelector<HTMLElement>('[data-evt]');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-item]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-shot]'));
    if (!items.length) return;
    root.classList.add('gc-evt-js');

    const activate = (index: number) => {
      items.forEach((el, i) => el.classList.toggle('is-active', i === index));
      shots.forEach((el, i) => el.classList.toggle('is-active', i === index));
    };

    activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          activate(Number((entry.target as HTMLElement).dataset.item));
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    items.forEach((el) => activeObserver!.observe(el));
  };

  const init = () => {
    initReveal();
    initActive();
    initGallery();
  };

  // 3) Galerie : carrousel INFINI. On entoure les photos d'une copie avant et d'une copie après ;
  //    dès qu'on s'approche d'un bord, on saute (sans que ça se voie) sur la même photo au milieu.
  //    Défilement automatique doux, mis en pause au survol / au toucher / au focus,
  //    avec un bouton pause (et désactivé si le visiteur a demandé moins d'animations).
  //    Sans JavaScript : carrousel simple, glissement tactile / clavier.
  const AUTO_MS = 4500;
  const initGallery = () => {
    document.querySelectorAll<HTMLElement>('[data-gal]').forEach((root) => {
      if (root.dataset.galReady) return;
      const track = root.querySelector<HTMLElement>('[data-gal-track]');
      const prev = root.querySelector<HTMLButtonElement>('[data-gal-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-gal-next]');
      const pause = root.querySelector<HTMLButtonElement>('[data-gal-pause]');
      if (!track || !prev || !next) return;
      const originals = Array.from(track.children) as HTMLElement[];
      const n = originals.length;
      if (n < 3) return;
      root.dataset.galReady = '1';

      const makeClones = () =>
        originals.map((li) => {
          const c = li.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.setAttribute('inert', '');
          c.dataset.clone = '1';
          return c;
        });
      track.prepend(...makeClones());
      track.append(...makeClones());

      let setW = 0;
      const measure = () => {
        setW = originals[0].offsetLeft - (track.children[0] as HTMLElement).offsetLeft;
      };
      const jump = (delta: number) => {
        track.classList.add('is-jumping');
        track.scrollLeft += delta;
        requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('is-jumping')));
      };
      const recentre = () => {
        if (track.scrollLeft < setW * 0.5) jump(setW);
        else if (track.scrollLeft > setW * 1.5) jump(-setW);
      };
      const step = () => {
        const item = originals[0];
        return item.getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || '16');
      };

      measure();
      track.classList.add('is-jumping');
      track.scrollLeft = setW;
      requestAnimationFrame(() => track.classList.remove('is-jumping'));

      let timer: number | undefined;
      track.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(recentre, 120);
        },
        { passive: true }
      );
      window.addEventListener('resize', () => {
        measure();
        track.classList.add('is-jumping');
        track.scrollLeft = setW;
        requestAnimationFrame(() => track.classList.remove('is-jumping'));
      });

      const go = (dir: 1 | -1) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      prev.disabled = false;
      next.disabled = false;
      prev.onclick = () => { go(-1); stopForGood(); };
      next.onclick = () => { go(1); stopForGood(); };

      // ── Défilement automatique ──
      // Si le visiteur a demandé « moins d'animations » (réglage du système), le défilement démarre
      // en pause : le bouton lecture reste affiché pour qu'il puisse le lancer lui-même.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let auto: number | undefined;
      let paused = reduce;    // pause demandée (bouton, réglage système ou action du visiteur)
      let hovering = false;   // souris sur les photos / focus clavier
      let visible = false;    // section à l'écran
      const setPaused = (value: boolean) => {
        paused = value;
        if (!pause) return;
        pause.setAttribute('aria-pressed', String(paused));
        pause.setAttribute('aria-label', (paused ? pause.dataset.labelPlay : pause.dataset.labelPause) || '');
        refresh();
      };
      function refresh() {
        window.clearInterval(auto);
        auto = undefined;
        if (paused || hovering || !visible) return;
        auto = window.setInterval(() => go(1), AUTO_MS);
      }
      function stopForGood() {
        // le visiteur pilote lui-même avec les flèches : on arrête l'automatique
        setPaused(true);
      }
      if (pause) {
        root.classList.add('is-auto');
        setPaused(reduce);
        pause.onclick = () => setPaused(!paused);
        // Pause uniquement quand la souris est SUR les photos (pas sur toute la section),
        // ou quand le carrousel est piloté au clavier.
        track.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovering = true; refresh(); } });
        track.addEventListener('pointerleave', () => { hovering = false; refresh(); });
        track.addEventListener('focus', () => { hovering = true; refresh(); });
        track.addEventListener('blur', () => { hovering = false; refresh(); });
        track.addEventListener('touchstart', () => setPaused(true), { passive: true });
        new IntersectionObserver(
          (entries) => { visible = entries[0].isIntersecting; refresh(); },
          { threshold: 0.4 }
        ).observe(root);
      }
    });
  };

  document.addEventListener('astro:page-load', init);
</script>
