  /* ══ FAQ ═════════════════════════════════════════════════════════════════ */
  .gc-prt-faq-inner { max-width: 50rem; }
  .gc-prt-faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .gc-prt-faq-item {
