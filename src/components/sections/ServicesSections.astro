---
import { Image } from 'astro:assets';
import heroImg    from '~/assets/images/SERVICES-hero.webp';
import imgDj      from '~/assets/images/SERVICES-prestation-dj.webp';
import imgSpeaker from '~/assets/images/SERVICES-prestation-speaker.webp';
import imgSono    from '~/assets/images/SERVICES-sono.webp';
import imgDesign  from '~/assets/images/SERVICES-design-sonore.webp';
import imgProd    from '~/assets/images/SERVICES-prod-event.webp';
import type { ServicesContent } from '~/data/pages/services';

export interface Props {
  t: ServicesContent;
  locale: 'fr' | 'en';
}

const { t, locale } = Astro.props;
const svcImages = [imgDj, imgSpeaker, imgSono, imgDesign, imgProd];

// Colle les guillemets français à leur contenu (jamais séparés en fin de ligne)
const nbsp = (s: string) => s.replace(/«\s+/g, '«\u00A0').replace(/\s+»/g, '\u00A0»');
---

<!-- ═══ HERO ═══════════════════════════════════════════════════════════════ -->
<section class="gc-hero-section gc-photo-hero">
  <Image
    src={heroImg}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="gc-hero-media gc-photo-hero-bg"
  />
  <div class="gc-photo-hero-overlay" aria-hidden="true"></div>
  <div class="gc-photo-hero-content">
    <span class="gc-page-eyebrow">{t.hero.eyebrow}</span>
    <h1 class="gc-photo-hero-h1 gc-photo-hero-h1-zoom">
      <span class="gc-photo-hero-h1-white">{t.hero.titleWhite}</span>
      {' '}
      <span class="gc-photo-hero-h1-gold gc-shimmer">{t.hero.titleGold}</span>
    </h1>
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ BANDEAU INTRO ═════════════════════════════════════════════════════ -->
<section class="gc-intro-band gc-reveal">
  <div class="gc-intro-band-inner">
    <h2 class="gc-intro-band-title">{t.intro.title}</h2>
    <p class="gc-intro-band-text" set:html={nbsp(t.intro.paragraph)} />
  </div>
</section>

<!-- ═══ SECTIONS 01-05 ════════════════════════════════════════════════════ -->
{t.services.map((svc, i) => (
  <section class:list={[
    'gc-srv-section gc-reveal',
    i % 2 === 0 ? 'gc-srv-section--white' : 'gc-srv-section--tint',
    svc.reverse && 'gc-srv-section--reverse',
  ]}>
    <div class="gc-srv-inner">

      <!-- Image -->
      <div class="gc-srv-media">
        <div class="gc-media-wrap gc-media-hover">
          <Image
            src={svcImages[i]}
            alt={svc.imageAlt}
            widths={[400, 700, 900]}
            sizes="(min-width: 1024px) 30vw, 92vw"
          />
        </div>
      </div>

      <!-- Contenu texte -->
      <div class="gc-srv-content">
        <span class="gc-sec-accroche">{svc.accroche}</span>
        <h2 class="gc-sec-title">{svc.title}</h2>
        {svc.subtitle && (
          <p class="gc-srv-subtitle-text">{nbsp(svc.subtitle)}</p>
        )}
        <div class="gc-srv-body gc-body-text" set:html={nbsp(svc.body)} />
        {svc.list && (
          <ul class="gc-srv-list">
            {svc.list.map((item) => {
              const it = nbsp(item);
              const dash = it.indexOf(' — ');
              return (
                <li class="gc-srv-list-item">
                  {dash > -1 ? (
                    <span class="gc-srv-list-text">
                      <strong>{it.slice(0, dash)}{locale === 'fr' ? '\u00A0:' : ':'}</strong>
                      <span class="gc-srv-list-rest">{' '}{it.slice(dash + 3)}</span>
                    </span>
                  ) : it}
                </li>
              );
            })}
          </ul>
        )}
        {svc.blockquote && (
          <blockquote class="gc-srv-blockquote">{nbsp(svc.blockquote)}</blockquote>
        )}
        {svc.link && (
          <a href={svc.link.href} class="gc-srv-link">
            {svc.link.text} →
          </a>
        )}
      </div>

    </div>
  </section>
))}

<!-- ═══ BANDEAU CITATION (après la section 05) ════════════════════════════ -->
<section class="gc-quote-banner gc-reveal">
  <div class="gc-quote-inner">
    <span class="gc-editorial-line" aria-hidden="true"></span>
    <blockquote set:html={nbsp(t.quoteBanner.quote)} />
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ CTA FINAL ═════════════════════════════════════════════════════════ -->
<section class="gc-final-cta gc-reveal">
  <div class="gc-final-cta-inner">
    <h2 class="gc-final-cta-title">
      <span class="gc-final-cta-title-1">{t.cta.titleWhite}</span>
      <span class="gc-final-cta-title-2 gc-shimmer">{t.cta.titleShimmer}</span>
    </h2>
    <p class="gc-final-cta-subtitle" set:html={nbsp(t.cta.subtitle)} />
    <div class="gc-btn-pair">
      <a href={t.cta.btnQuote.href} class="btn-gc-primary">{t.cta.btnQuote.text}</a>
      <a href={t.cta.btnContact.href} class="btn-gc-outline">{t.cta.btnContact.text}</a>
    </div>
  </div>
</section>

<style>
  /* Toutes les couleurs proviennent des variables de palette (voir tailwind.css) :
     --gc-surface #FFFFFF · --gc-surface-alt #F2F2F2 · --gc-ink #0D0D0D · --gc-gold #AF9453 */

  /* Bandeau intro : voir .gc-intro-band* (classes partagées, tailwind.css) */

  /* ── Sections 01-05 ─────────────────────────────────────────────────── */
  .gc-srv-section {
    min-height: auto;
    display: flex;
    align-items: center;
  }
  .gc-srv-section--white { background-color: var(--gc-surface); color: var(--gc-ink); }
  .gc-srv-section--tint  { background-color: var(--gc-surface-alt); color: var(--gc-ink); }

  .gc-srv-inner {
    width: 100%;
    max-width: 80rem;
    margin-inline: auto;
    padding: 3.5rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .gc-srv-section { min-height: 100svh; }
    /* Image = 1 tiers, texte = 2 tiers */
    .gc-srv-inner {
      grid-template-columns: 1fr 2fr;
      grid-template-areas: 'media content';
      align-items: center;
      gap: 4rem;
      padding: 5rem 2rem;
    }
    /* Sections inversées : on inverse AUSSI les colonnes (point 7)
       → l'image reste à 1 tiers, le texte à 2 tiers */
    .gc-srv-section--reverse .gc-srv-inner {
      grid-template-columns: 2fr 1fr;
      grid-template-areas: 'content media';
    }
    .gc-srv-media   { grid-area: media; }
    .gc-srv-content { grid-area: content; }
    /* sections image-à-droite : coller le texte vers l'image (gap régulier) */
    .gc-srv-section--reverse .gc-srv-content { margin-left: auto; }
  }

  /* ── Image (centrée dans son tiers, 80vh) ───────────────────────────── */
  .gc-srv-media {
    display: flex;
    justify-content: center;
  }
  .gc-media-wrap {
    width: 100%;
    max-width: 24rem;
    height: 50vh;
    margin-inline: auto;
    border-radius: 2px;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .gc-media-wrap {
      height: 80vh;
      max-width: 26rem;
    }
  }
  .gc-media-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Contenu section ────────────────────────────────────────────────── */
  .gc-srv-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 44rem;
  }
  .gc-srv-subtitle-text {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.82rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gc-gold);
    margin-bottom: 1.5rem;
  }

  /* Corps texte HTML — noir #0D0D0D, interligne resserré (points 8 & 3) */
  /* Taille et interligne : voir .gc-body-text (appliquée en plus sur l'élément) */
  .gc-srv-body {
    color: var(--gc-ink);
    margin-bottom: 0.25rem;
  }
  .gc-srv-body :global(p)            { margin-bottom: 1rem; }
  .gc-srv-body :global(p:last-child) { margin-bottom: 0; }
  .gc-srv-body :global(strong)       { font-weight: 700; }

  /* Liste à puces ▶ or — texte avant le tiret en gras (point 12) */
  .gc-srv-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .gc-srv-list-item {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--gc-ink);
  }
  .gc-srv-list-item::before {
    content: '▶';
    color: var(--gc-gold);
    font-size: 0.55em;
    flex-shrink: 0;
    line-height: 2;
  }
  .gc-srv-list-item strong { font-weight: 700; }
  /* Mobile : le texte après « Titre : » passe à la ligne */
  @media (max-width: 767px) {
    .gc-srv-list-rest { display: block; }
  }

  /* Encadré citation or (section 03) */
  .gc-srv-blockquote {
    border-left: 2px solid var(--gc-gold);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: 0.88rem;
    line-height: 1.6;
    font-style: italic;
    color: var(--gc-ink);
  }

  /* Lien action */
  .gc-srv-link {
    display: inline-flex;
    align-items: center;
    margin-top: 1.5rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gc-gold);
    position: relative;
    width: fit-content;
  }
  .gc-srv-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background-color: var(--gc-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .gc-srv-link:hover::after { transform: scaleX(1); }

</style>

<script>
  // Avec le ClientRouter, ce script ne s'exécute qu'une fois : sans ce
  // (ré)armement à chaque chargement de page, les sections .gc-reveal restaient
  // invisibles (opacity 0) après un changement de langue.
  let observer: IntersectionObserver | null = null;

  const initReveal = () => {
    observer?.disconnect();
    const revealEls = document.querySelectorAll<HTMLElement>('.gc-reveal');
    if (!revealEls.length) return;
    observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        });
      },
      // rootMargin négatif en bas : la section se révèle quand elle est
      // déjà bien entrée dans l'écran → on voit le fondu + glissement
      { threshold: 0.1, rootMargin: '0px 0px -25% 0px' }
    );
    revealEls.forEach((el) => observer!.observe(el));
  };

  document.addEventListener('astro:page-load', initReveal);
</script>
