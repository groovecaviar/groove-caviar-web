---
import { Image } from 'astro:assets';
import heroImg from '~/assets/images/MUSIQUE-hero.webp';
import cover1 from '~/assets/images/mixes/cocktail-mix-bossa-nova.webp';
import cover2 from '~/assets/images/mixes/cocktail-mix-musique-cubaine.webp';
import cover3 from '~/assets/images/mixes/dinner-mix-urban-smooth-jazz.webp';
import cover4 from '~/assets/images/mixes/party-mix-soul-x-funk-x-disco.webp';
import cover5 from '~/assets/images/mixes/party-mix-funky-house-classics-vol1.webp';
import cover6 from '~/assets/images/mixes/party-mix-dance-90s.webp';
import cover7 from '~/assets/images/mixes/party-mix-dance-all-night-vol1.webp';
import cover8 from '~/assets/images/mixes/party-mix-dance-all-night-vol2.webp';
import { MIXCLOUD_USER, spotifyUrl } from '~/data/pages/music';
import type { MusicContent } from '~/data/pages/music';

export interface Props {
  t: MusicContent;
  locale: 'fr' | 'en';
}

const { t } = Astro.props;
const covers = [cover1, cover2, cover3, cover4, cover5, cover6, cover7, cover8];

// Colle les guillemets français à leur contenu (jamais séparés en fin de ligne)
const nbsp = (s: string) => s.replace(/«\s+/g, '« ').replace(/\s+»/g, ' »');

// Numérote les 12 étapes (01 → 12) ; le groupe « S » est découpé en deux lignes de 3.
let counter = 0;
const groups = t.playlists.groups.map((g) => {
  const rows = g.serpentine ? [g.steps.slice(0, 3), g.steps.slice(3)] : [g.steps];
  return {
    label: g.label,
    serpentine: Boolean(g.serpentine),
    rows: rows.map((row) => row.map((s) => ({ ...s, num: String(++counter).padStart(2, '0') }))),
  };
});
---

<!-- ═══ HERO ═══════════════════════════════════════════════════════════════ -->
<section class="gc-hero-section gc-photo-hero">
  <Image
    src={heroImg}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="gc-hero-media gc-photo-hero-bg"
  />
  <div class="gc-photo-hero-overlay" aria-hidden="true"></div>
  <div class="gc-photo-hero-content">
    <span class="gc-page-eyebrow">{t.hero.eyebrow}</span>
    <h1 class="gc-photo-hero-h1 gc-photo-hero-h1-zoom"><span class="gc-photo-hero-h1-gold gc-shimmer">{t.hero.title}</span></h1>
    <span class="gc-editorial-line" aria-hidden="true"></span>
  </div>
</section>

<!-- ═══ BANDEAU INTRO ═════════════════════════════════════════════════════ -->
<section class="gc-intro-band gc-reveal">
  <div class="gc-intro-band-inner">
    <h2 class="gc-intro-band-title" set:html={nbsp(t.intro.title)} />
    {t.intro.paragraphs.map((p) => <p class="gc-intro-band-text gc-mus-intro-p" set:html={nbsp(p)} />)}
  </div>
</section>

<!-- ═══ MIXES ═════════════════════════════════════════════════════════════ -->
<section class="gc-sec gc-sec--white gc-reveal">
  <div class="gc-sec-inner">
    <header class="gc-sec-head">
      <span class="gc-sec-accroche">{t.mixes.accroche}</span>
      <h2 class="gc-sec-title">{t.mixes.title}</h2>
      <p class="gc-body-text">{nbsp(t.mixes.hint)}<br /><em>{nbsp(t.mixes.hintNote)}</em></p>
    </header>

    <ul class="gc-mus-mixes" data-mixcloud-user={MIXCLOUD_USER} data-player-title={t.mixes.playerTitle}>
      {t.mixes.items.map((m, i) => (
        <li class="gc-mus-mix">
          <button
            type="button"
            class="gc-mus-mix-btn"
            data-slug={m.slug}
            data-title={m.title}
            aria-label={`${t.mixes.playLabel} ${m.title}`}
          >
            <Image
              src={covers[i]}
              alt=""
              widths={[400, 700, 1080]}
              sizes="(min-width: 768px) 40vw, 92vw"
              loading="lazy"
              class="gc-mus-cover"
            />
            <span class="gc-mus-play" aria-hidden="true">▶</span>
          </button>
          <h3 class="gc-mus-mix-title">{m.title}</h3>
          <div class="gc-mus-mix-player" aria-live="polite"></div>
        </li>
      ))}
    </ul>

    <div class="gc-mus-outro">
      <p class="gc-body-text gc-mus-outro-text" set:html={nbsp(t.mixes.outro)} />
      <a href={t.mixes.profile.href} class="btn-gc-primary" target="_blank" rel="noopener noreferrer">
        {t.mixes.profile.text} ↗
      </a>
    </div>
  </div>
</section>

<!-- ═══ PLAYLISTS MARIAGES ════════════════════════════════════════════════ -->
<section id={t.playlists.anchor} class="gc-sec gc-sec--tint gc-reveal">
  <div class="gc-sec-inner">
    <header class="gc-sec-head">
      <span class="gc-sec-accroche">{t.playlists.accroche}</span>
      <h2 class="gc-sec-title">{t.playlists.title}</h2>
      <p class="gc-body-text">{nbsp(t.playlists.intro)}</p>
    </header>

    <!-- Frise : église, cérémonie, puis le « S » -->
    {groups.map((g) => (
      <div class:list={['gc-mus-group', g.serpentine && 'gc-mus-group--s']}>
        <h3 class="gc-page-eyebrow gc-mus-group-label">{g.label}</h3>
        <div class="gc-mus-body" data-draw>
          {g.rows.map((row, ri) => (
            <ol class:list={['gc-mus-row', g.serpentine && ri === 1 && 'gc-mus-row--rev']}>
              {row.map((s) => (
                <li class="gc-mus-step">
                  <a
                    href={spotifyUrl(s.id)}
                    class="gc-mus-node"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="gc-mus-dot" aria-hidden="true"></span>
                    <span class="gc-eyebrow-num gc-mus-num" aria-hidden="true">{s.num}</span>
                    <span class="gc-mus-name">{nbsp(s.name)}</span>
                    <span class="gc-mus-listen">{t.playlists.listen} <span aria-hidden="true">↗</span><span class="sr-only"> — Spotify</span></span>
                  </a>
                </li>
              ))}
            </ol>
          ))}
        </div>
      </div>
    ))}

    <!-- Décennies : disques vinyle en carrousel -->
    <h3 class="gc-mus-decades-title">
      {t.playlists.decadesTitle}
      <span>{t.playlists.decadesSubtitle}</span>
    </h3>
    <div class="gc-mus-carousel" data-carousel>
      <button type="button" class="gc-mus-arrow" data-dir="-1" aria-label={t.playlists.prevLabel}>‹</button>
      <ul class="gc-mus-discs" data-viewport>
        {[0, 1].map((copy) =>
          t.playlists.decades.map((d) => (
            <li class="gc-mus-disc-item" aria-hidden={copy === 1 ? 'true' : undefined}>
              <a
                href={spotifyUrl(d.id)}
                class="gc-mus-disc-link"
                target="_blank"
                rel="noopener noreferrer"
                tabindex={copy === 1 ? -1 : undefined}
                draggable="false"
              >
                <span class="gc-mus-disc" aria-hidden="true">
                  <span class="gc-mus-disc-label">{d.short}</span>
                </span>
                <span class="gc-mus-disc-caption">{d.label}<span class="sr-only"> — Spotify</span></span>
              </a>
            </li>
          ))
        )}
      </ul>
      <button type="button" class="gc-mus-arrow" data-dir="1" aria-label={t.playlists.nextLabel}>›</button>
    </div>

    <div class="gc-mus-closing">
      {t.playlists.outro.map((p) => <p class="gc-body-text" set:html={nbsp(p)} />)}
    </div>
  </div>
</section>

<!-- ═══ CTA FINAL ═════════════════════════════════════════════════════════ -->
<section class="gc-final-cta gc-reveal">
  <div class="gc-final-cta-inner">
    <h2 class="gc-final-cta-title">
      <span class="gc-final-cta-title-1">{t.cta.titleWhite}</span>
      <span class="gc-final-cta-title-2 gc-shimmer">{t.cta.titleShimmer}</span>
    </h2>
    <p class="gc-final-cta-subtitle" set:html={nbsp(t.cta.subtitle)} />
    <div class="gc-btn-pair">
      <a href={t.cta.btnQuote.href} class="btn-gc-primary">{t.cta.btnQuote.text}</a>
      <a href={t.cta.btnContact.href} class="btn-gc-outline">{t.cta.btnContact.text}</a>
    </div>
  </div>
</section>

<style>
  /* Couleurs : variables de palette (tailwind.css) — --gc-surface #FFFFFF · --gc-surface-alt #F2F2F2
     --gc-ink #0D0D0D · --gc-gold #AF9453. Styles spécifiques à la page Musique, préfixés gc-mus- ;
     le reste vient des classes partagées de tailwind.css (gc-sec*, gc-photo-hero*, gc-final-cta*, …). */

  .gc-mus-intro-p + .gc-mus-intro-p { margin-top: 1rem; }
  /* Ancre : le début de la section ne se cache pas sous l'en-tête fixe */
  #playlists-mariages, #wedding-playlists { scroll-margin-top: 5rem; }

  /* ── Mixes : 2 colonnes × 4, façade « cliquer pour écouter » ───────── */
  .gc-mus-mixes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem 2.25rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .gc-mus-mixes { grid-template-columns: 1fr 1fr; }
  }
  .gc-mus-mix-btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 0;
    border-radius: 2px;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--gc-ink);
  }
  .gc-mus-mix-btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #0D0D0D66 0%, #0D0D0D00 55%);
    pointer-events: none;
  }
  .gc-mus-mix-btn :global(.gc-mus-cover) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  @media (hover: hover) {
    .gc-mus-mix-btn:hover :global(.gc-mus-cover) { transform: scale(1.04); }
  }
  .gc-mus-play {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 4.25rem;
    height: 4.25rem;
    margin: -2.125rem 0 0 -2.125rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    padding-left: 0.2rem;
    font-size: 1.15rem;
    color: var(--gc-ink);
    background-color: var(--gc-gold);
    box-shadow: 0 8px 24px #0D0D0D4D;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }
  .gc-mus-mix-btn:hover .gc-mus-play,
  .gc-mus-mix-btn:focus-visible .gc-mus-play { transform: scale(1.1); background-color: #FFFFFF; }
  .gc-mus-mix-btn:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 3px; }
  .gc-mus-mix.is-active .gc-mus-play { display: none; }
  .gc-mus-mix.is-active .gc-mus-mix-btn { cursor: default; }
  .gc-mus-mix-title {
    margin: 1rem 0 0;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--gc-ink);
  }
  .gc-mus-mix-player :global(iframe) {
    display: block;
    width: 100%;
    height: 120px;
    border: 0;
    margin-top: 0.9rem;
  }

  .gc-mus-outro { margin-top: 3.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.75rem; }
  .gc-mus-outro-text { max-width: 38rem; }

  /* ── Frise des étapes (lignes dorées horizontales) ──────────────────── */
  .gc-mus-group { --gc-mus-gap: 2.5rem; max-width: 56rem; margin: 0 auto 3.5rem; }
  .gc-mus-group-label { text-align: center; } /* le reste vient de .gc-page-eyebrow */
  .gc-mus-body { padding-inline: 2rem; }
  .gc-mus-group--s .gc-mus-body { display: grid; grid-auto-rows: 1fr; row-gap: var(--gc-mus-gap); }

  .gc-mus-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    position: relative;
  }
  /* Trait doré : du centre du 1er point au centre du 3e (se dessine au scroll) */
  .gc-mus-row::before {
    content: '';
    position: absolute;
    top: 6px;
    left: 16.667%;
    right: 16.667%;
    height: 1px;
    background-color: var(--gc-gold);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.6s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .gc-mus-body.is-drawn .gc-mus-row::before { transform: scaleX(1); }

  /* Le « S » : les lignes 3 et 4 se prolongent à droite et sont reliées par un demi-cercle */
  .gc-mus-group--s .gc-mus-row::before { right: 0; }
  .gc-mus-row--rev { direction: rtl; }
  .gc-mus-row--rev::before { transform-origin: right center; transition-delay: 1.5s; }
  .gc-mus-row--rev::after {
    content: '';
    position: absolute;
    right: -2rem;
    width: 2rem;
    top: calc(6px - 100% - var(--gc-mus-gap));
    height: calc(100% + var(--gc-mus-gap));
    border: 1px solid var(--gc-gold);
    border-left: 0;
    border-radius: 0 100% 100% 0 / 0 50% 50% 0;
    opacity: 0;
    transition: opacity 0.6s ease 1.1s;
  }
  .gc-mus-body.is-drawn .gc-mus-row--rev::after { opacity: 1; }

  .gc-mus-step { list-style: none; }
  .gc-mus-node {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 0.75rem;
    direction: ltr;
    color: var(--gc-ink);
    text-decoration: none;
  }
  .gc-mus-dot {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid var(--gc-gold);
    background-color: var(--gc-surface-alt);
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .gc-mus-num { margin-top: 1rem; } /* le reste vient de .gc-eyebrow-num */
  .gc-mus-name {
    margin-top: 0.35rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.25;
    transition: color 0.3s ease;
  }
  .gc-mus-listen {
    margin-top: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--gc-gold);
    opacity: 0.65;
    transition: opacity 0.3s ease;
  }
  .gc-mus-node:hover .gc-mus-dot,
  .gc-mus-node:focus-visible .gc-mus-dot { background-color: var(--gc-gold); transform: scale(1.3); }
  .gc-mus-node:hover .gc-mus-name,
  .gc-mus-node:focus-visible .gc-mus-name { color: var(--gc-gold); }
  .gc-mus-node:hover .gc-mus-listen,
  .gc-mus-node:focus-visible .gc-mus-listen { opacity: 1; }
  .gc-mus-node:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 6px; }

  /* Mobile : une seule ligne verticale par groupe */
  @media (max-width: 767px) {
    .gc-mus-body { padding-inline: 0; }
    .gc-mus-group { margin-bottom: 3rem; --gc-mus-gap: 1.75rem; }
    .gc-mus-group-label { text-align: left; }
    .gc-mus-row { grid-template-columns: 1fr; row-gap: 1.75rem; padding-left: 2rem; direction: ltr; }
    .gc-mus-row::before {
      top: 6px; bottom: 0; left: 5px; right: auto; width: 1px; height: auto;
      transform: scaleY(0); transform-origin: top center;
    }
    .gc-mus-body.is-drawn .gc-mus-row::before { transform: scaleY(1); }
    .gc-mus-group--s .gc-mus-row::before { right: auto; }
    .gc-mus-group--s .gc-mus-row:first-child::before { bottom: calc(-1 * var(--gc-mus-gap)); }
    .gc-mus-row--rev::before { transform-origin: top center; transition-delay: 1.2s; }
    .gc-mus-row--rev::after { display: none; }
    .gc-mus-node { align-items: flex-start; text-align: left; padding: 0; }
    .gc-mus-dot { position: absolute; left: -2rem; top: 0.1rem; }
    .gc-mus-num { margin-top: 0; }
  }

  /* ── Décennies : disques vinyle ─────────────────────────────────────── */
  .gc-mus-decades-title {
    text-align: center;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: clamp(1.1rem, 2.4vw, 1.4rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: var(--gc-ink);
    margin: 1rem 0 1.5rem;
  }
  .gc-mus-decades-title span { display: block; font-weight: 400; font-style: italic; color: var(--gc-gold); }

  /* Carrousel : flèches à gauche et à droite, pas de barre de défilement */
  .gc-mus-carousel {
    --gc-mus-disc: 11rem;   /* diamètre des disques */
    --gc-mus-arrow: 2.75rem; /* diamètre des flèches */
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }
  .gc-mus-discs {
    flex: 1 1 auto;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 1.25rem 0 2.25rem;
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    /* Bords gauche et droite en fondu transparent (les disques apparaissent / disparaissent doucement) */
    -webkit-mask-image: linear-gradient(to right, #00000000 0%, #000000 4%, #000000 96%, #00000000 100%);
    mask-image: linear-gradient(to right, #00000000 0%, #000000 4%, #000000 96%, #00000000 100%);
  }
  .gc-mus-discs.is-dragging { cursor: grabbing; user-select: none; }
  .gc-mus-discs::-webkit-scrollbar { display: none; }
  .gc-mus-arrow {
    flex: 0 0 auto;
    width: var(--gc-mus-arrow);
    height: var(--gc-mus-arrow);
    /* centre de la flèche = centre des disques (padding haut du défilement 1.25rem) */
    margin-top: calc(1.25rem + var(--gc-mus-disc) / 2 - var(--gc-mus-arrow) / 2);
    border-radius: 50%;
    border: 1px solid var(--gc-gold);
    background: transparent;
    color: var(--gc-gold);
    font-size: 1.6rem;
    line-height: 1;
    padding-bottom: 0.15rem;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, opacity 0.3s ease;
  }
  .gc-mus-arrow:hover,
  .gc-mus-arrow:focus-visible { background-color: var(--gc-gold); color: var(--gc-ink); }
  .gc-mus-arrow:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 3px; }
  @media (max-width: 767px) {
    .gc-mus-carousel { --gc-mus-disc: 8.5rem; --gc-mus-arrow: 2.25rem; gap: 0.75rem; }
    .gc-mus-arrow { font-size: 1.3rem; }
    .gc-mus-discs { gap: 1.25rem; }
  }
  .gc-mus-disc-item { flex: 0 0 auto; }
  .gc-mus-disc-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    color: var(--gc-ink);
    text-decoration: none;
  }
  .gc-mus-disc {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--gc-mus-disc);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--gc-ink);
    box-shadow: 0 14px 12px -12px #0D0D0D66; /* ombre sous le disque uniquement, sans déborder sur les côtés */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Sillons + reflet : seule cette couche tourne au survol */
  .gc-mus-disc::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      conic-gradient(from 0deg, #FFFFFF00 0%, #FFFFFF2E 12%, #FFFFFF00 25%, #FFFFFF00 50%, #FFFFFF2E 62%, #FFFFFF00 75%),
      repeating-radial-gradient(circle at center, #0D0D0D 0 2px, #1F1F1F 2px 3px);
  }
  .gc-mus-disc-label {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--gc-gold);
    color: var(--gc-ink);
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .gc-mus-disc-caption {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    transition: color 0.3s ease;
  }
  .gc-mus-disc-link:hover .gc-mus-disc-caption,
  .gc-mus-disc-link:focus-visible .gc-mus-disc-caption { color: var(--gc-gold); }
  .gc-mus-disc-link:focus-visible { outline: 2px solid var(--gc-gold); outline-offset: 6px; }
  @media (hover: hover) {
    .gc-mus-disc-link:hover .gc-mus-disc { transform: scale(1.06); }
    .gc-mus-disc-link:hover .gc-mus-disc::before { animation: gc-mus-spin 3.5s linear infinite; }
  }
  @keyframes gc-mus-spin { to { transform: rotate(360deg); } }
  @media (max-width: 767px) { .gc-mus-disc-label { font-size: 1.5rem; } }

  .gc-mus-closing { max-width: 42rem; margin: 3rem auto 0; text-align: center; display: flex; flex-direction: column; gap: 1rem; }

  /* Mouvement réduit : tout est affiché tout de suite, sans animation */
  @media (prefers-reduced-motion: reduce) {
    .gc-mus-row::before { transform: none !important; transition: none !important; }
    .gc-mus-row--rev::after { opacity: 1; transition: none; }
    .gc-mus-disc-link:hover .gc-mus-disc::before { animation: none; }
  }
</style>

<script>
  // Re-armé à chaque chargement de page (ClientRouter) : fondu des sections + tracé des lignes dorées.
  let observer: IntersectionObserver | null = null;

  const initReveal = () => {
    observer?.disconnect();
    const els = document.querySelectorAll<HTMLElement>('.gc-reveal, [data-draw]');
    if (!els.length) return;
    observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          el.classList.add(el.hasAttribute('data-draw') ? 'is-drawn' : 'is-visible');
          obs.unobserve(el);
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -25% 0px' }
    );
    els.forEach((el) => observer!.observe(el));
  };
  document.addEventListener('astro:page-load', initReveal);

  // Carrousel des disques : défilement automatique en boucle, qui s'arrête au survol / à la prise en main.
  // Les disques sont affichés deux fois (la 2e série est masquée aux lecteurs d'écran) pour boucler sans saut.
  // Manuel : glisser à la souris, molette / trackpad / doigt, ou flèches. Aucun mouvement si « réduire les animations ».
  const SPEED = 0.045; // pixels par milliseconde (≈ 45 px/s)
  const initCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
      if (c.dataset.ready) return;
      c.dataset.ready = '1';
      const v = c.querySelector<HTMLElement>('[data-viewport]');
      const items = v?.querySelectorAll<HTMLElement>('.gc-mus-disc-item');
      if (!v || !items || items.length < 2) return;
      const half = items.length / 2;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let loop = 0;
      let pos = 0;
      let last = performance.now();
      let resumeAt = 0;
      let hovering = false;
      let focused = false;
      let dragging = false;
      let visible = true;
      let dragX = 0;
      let dragMoved = 0;

      const measure = () => {
        loop = items[half].offsetLeft - items[0].offsetLeft;
      };
      const wrap = () => {
        if (!loop) return;
        // zone stable : [1, loop + 1] ; au-delà, on saute d'une série (identique à l'écran)
        if (v.scrollLeft > loop + 1) v.scrollLeft -= loop;
        else if (v.scrollLeft < 1) v.scrollLeft += loop;
      };
      const hold = (ms: number) => {
        resumeAt = performance.now() + ms;
      };

      measure();
      window.addEventListener('resize', measure);
      v.scrollLeft = loop;
      pos = v.scrollLeft;

      v.addEventListener('scroll', () => {
        wrap();
        // défilement venant de l'utilisateur (doigt, molette, flèches) : on laisse la main un moment
        if (Math.abs(v.scrollLeft - pos) > 2) hold(3000);
      }, { passive: true });

      c.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hovering = true; });
      c.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { hovering = false; hold(400); } });
      c.addEventListener('focusin', () => { focused = true; });
      c.addEventListener('focusout', () => { focused = false; hold(400); });

      // Glisser à la souris
      v.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        dragging = true;
        dragX = e.clientX;
        dragMoved = 0;
        v.classList.add('is-dragging');
      });
      window.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - dragX;
        dragX = e.clientX;
        dragMoved += Math.abs(dx);
        v.scrollLeft -= dx;
      });
      window.addEventListener('pointerup', () => {
        if (!dragging) return;
        dragging = false;
        v.classList.remove('is-dragging');
        hold(400);
      });
      // Après un glissé, on n'ouvre pas le lien sur lequel la souris est relâchée
      v.addEventListener('click', (e) => {
        if (dragMoved > 5) { e.preventDefault(); e.stopPropagation(); dragMoved = 0; }
      }, true);
      v.addEventListener('dragstart', (e) => e.preventDefault());

      // Flèches
      c.querySelectorAll<HTMLButtonElement>('.gc-mus-arrow').forEach((btn) =>
        btn.addEventListener('click', () => {
          hold(3000);
          v.scrollBy({ left: Number(btn.dataset.dir) * v.clientWidth * 0.8, behavior: 'smooth' });
        })
      );

      // Pas d'animation hors de l'écran
      new IntersectionObserver((entries) => {
        visible = entries[0]?.isIntersecting ?? true;
      }).observe(c);

      const tick = (now: number) => {
        if (!c.isConnected) return;
        const dt = Math.min(now - last, 64);
        last = now;
        if (!reduce && visible && !hovering && !focused && !dragging && now >= resumeAt && loop) {
          pos += dt * SPEED;
          if (pos > loop + 1) pos -= loop;
          v.scrollLeft = pos;
        } else {
          pos = v.scrollLeft;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  };
  document.addEventListener('astro:page-load', initCarousels);

  // Façade Mixcloud : le lecteur tiers n'est chargé qu'au clic (rapidité + RGPD).
  // Écouteur délégué, posé une seule fois (le script ne s'exécute qu'une fois avec le ClientRouter).
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as Element | null)?.closest<HTMLButtonElement>('.gc-mus-mix-btn');
    if (!btn) return;
    const li = btn.closest<HTMLElement>('.gc-mus-mix');
    const list = btn.closest<HTMLElement>('.gc-mus-mixes');
    const slot = li?.querySelector<HTMLElement>('.gc-mus-mix-player');
    if (!li || !list || !slot || slot.querySelector('iframe')) return;
    const feed = encodeURIComponent(`/${list.dataset.mixcloudUser}/${btn.dataset.slug}/`);
    const frame = document.createElement('iframe');
    frame.src = `https://player-widget.mixcloud.com/widget/iframe/?hide_cover=1&autoplay=1&feed=${feed}`;
    frame.title = `${list.dataset.playerTitle ?? ''} ${btn.dataset.title ?? ''}`.trim();
    frame.allow = 'autoplay';
    frame.setAttribute('frameborder', '0');
    slot.appendChild(frame);
    li.classList.add('is-active');
  });
</script>
