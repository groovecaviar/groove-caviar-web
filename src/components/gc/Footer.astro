---
import logoUrl from '~/assets/images/logo-circulaire.svg?url';
import { getLocale, useTranslations } from '~/i18n/ui';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const p = (frVal: string, enVal: string) => (locale === 'fr' ? frVal : enVal);

const homeHref = p('/', '/en');

// ---- Navigation ----
const footerNav = [
  { label: t.nav.weddings, href: p('/mariages', '/en/weddings') },
  { label: t.nav.parties, href: p('/soirees', '/en/parties') },
  { label: t.nav.events, href: p('/evenements', '/en/events') },
  { label: t.nav.services, href: p('/services', '/en/services') },
  { label: t.nav.music, href: p('/musique', '/en/music') },
  { label: t.nav.about, href: p('/a-propos', '/en/about') },
  { label: t.nav.faq, href: p('/faq', '/en/faq') },
  { label: t.nav.contact, href: p('/contact', '/en/contact') },
];

// ---- Coordonnées (NAP) ----
const nap = {
  address: '3 allée Gabrielle Dorziat, 64200 Biarritz',
  maps: 'https://maps.app.goo.gl/5PteWHKmc19sPByR7',
  phoneDisplay: '06 23 62 57 04',
  phoneHref: 'tel:+33623625704',
  email: 'contact@groovecaviar.com',
};

// ---- Réseaux sociaux (icônes monochromes, viewBox 0 0 24 24) ----
const socials = [
