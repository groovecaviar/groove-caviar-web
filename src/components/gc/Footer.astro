  },
  {
    name: 'Spotify',
    href: 'https://open.spotify.com/user/yvc9dh69dsfayamamf07z2p9w',
    path: 'M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/groovecaviar/about/',
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z',
  },
];

// ---- Newsletter Brevo ----
const brevoAction =
  'https://9779d3f4.sibforms.com/serve/MUIFAJXUKhe4Tg-SyrEIG03ZG5Xm7vu618IWtdKsZMo5MhNsieXvApcsJ6CHHoaJ3SrnV0gjv-7Cm8Nuz7TeUIR0gPCDn3MJ4LCcDPbJlu--pgnkD_t-EuJyPT2BYMxOv5CTYbm1rdsBUG4S9uti-xRw1HrEAgrxe5v3Z8ANKU4jqpH7fh14n0Og8l6JRIwTOJXQKdSxRTc-uq9t8Q==';

// Textes
const tagline = p(
  'DJ & direction musicale haut de gamme pour mariages, soirées et événements d’exception.',
  'Premium DJ & music curation for weddings, parties and exceptional events.'
);
const navTitle = p('Navigation', 'Navigation');
const socialTitle = p('Réseaux sociaux', 'Follow us');
const newsTitle = 'Newsletter';
const newsIntro = p(
  'Dates, sélections musicales et coulisses — directement dans votre boîte mail.',
  'Dates, music selections and behind-the-scenes — straight to your inbox.'
);
const emailPlaceholder = p('Votre email', 'Your email');
const subscribeLabel = p('S’inscrire', 'Subscribe');
const successMsg = p('Votre inscription est confirmée.', 'Your subscription is confirmed.');
const errorMsg = p(
  'Nous n’avons pas pu confirmer votre inscription.',
  'We could not confirm your subscription.'
);
const rights = p('Tous droits réservés.', 'All rights reserved.');
const year = new Date().getFullYear();

// ---- Liens légaux (pages dédiées) ----
const legalLinks = [
  {
    label: p('Politique de confidentialité', 'Privacy Policy'),
    href: p('/politique-de-confidentialite', '/en/privacy-policy'),
  },
  {
    label: p('Conditions générales de vente', 'Terms of Sale'),
    href: p('/conditions-generales-de-vente', '/en/terms-of-sale'),
  },
];

// ---- JSON-LD LocalBusiness ----
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.groovecaviar.com',
  name: 'Groove Caviar',
  description: tagline,
  url: 'https://www.groovecaviar.com',
  telephone: '+33623625704',
  email: nap.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3 allée Gabrielle Dorziat',
    postalCode: '64200',
    addressLocality: 'Biarritz',
    addressRegion: 'Nouvelle-Aquitaine',
    addressCountry: 'FR',
  },
  areaServed: 'Pays Basque, Landes, France',
  sameAs: socials.map((s) => s.href),
};

// ---- Config Brevo (localisée), injectée avant main.js ----
const brevoConfig = `
window.REQUIRED_CODE_ERROR_MESSAGE = '${p('Veuillez choisir un code pays', 'Please choose a country code')}';
window.LOCALE = '${locale}';
window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "${p('Les informations fournies ne sont pas valides. Veuillez vérifier le format du champ et réessayer.', 'The information provided is invalid. Please check the field format and try again.')}";
window.REQUIRED_ERROR_MESSAGE = "${p('Vous devez renseigner ce champ.', 'This field is required.')}";
window.GENERIC_INVALID_MESSAGE = "${p('Les informations fournies ne sont pas valides. Veuillez vérifier le format du champ et réessayer.', 'The information provided is invalid. Please check the field format and try again.')}";
window.translation = { common: { selectedList: '{quantity} liste sélectionnée', selectedLists: '{quantity} listes sélectionnées', selectedOption: '{quantity} sélectionné', selectedOptions: '{quantity} sélectionnés' } };
var AUTOHIDE = Boolean(0);
`;
---

<footer class="gc-footer">
  <div class="gc-footer-inner">
    <div class="gc-footer-grid">
      <!-- Colonne 1 : Marque + coordonnées -->
      <div class="gc-footer-col">
        <a href={homeHref} class="gc-footer-brand" aria-label="Groove Caviar — accueil">
          <img src={logoUrl} alt="" width="40" height="40" class="gc-footer-logo" />
          <span class="brand gc-footer-wordmark">Groove Caviar</span>
        </a>
        <p class="gc-footer-tagline">{tagline}</p>
        <address class="gc-footer-nap">
          <a href={nap.maps} target="_blank" rel="noopener" class="gc-footer-napline">{nap.address}</a>
          <a href={nap.phoneHref} data-track="call-click" class="gc-footer-napline">{nap.phoneDisplay}</a>
          <a href={`mailto:${nap.email}`} data-track="email-click" class="gc-footer-napline">{nap.email}</a>
        </address>
      </div>

      <!-- Colonne 2 : Navigation -->
      <nav class="gc-footer-col" aria-label={navTitle}>
        <h3 class="gc-footer-title">{navTitle}</h3>
        <ul class="gc-footer-links">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="gc-footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Colonne 3 : Réseaux + Newsletter -->
      <div class="gc-footer-col">
        <h3 class="gc-footer-title">{socialTitle}</h3>
        <div class="gc-footer-socials">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="gc-footer-social"
              aria-label={s.name}
              data-track="social-click"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </div>

        <h3 class="gc-footer-title gc-footer-title--news">{newsTitle}</h3>
        <p class="gc-footer-news-intro">{newsIntro}</p>

        <div class="gc-news">
          <div id="error-message" class="sib-form-message-panel gc-news-msg gc-news-msg--error">{errorMsg}</div>
          <div id="success-message" class="sib-form-message-panel gc-news-msg gc-news-msg--success">{successMsg}</div>

          <div id="sib-form-container">
            <div id="sib-container">
              <form id="sib-form" method="POST" action={brevoAction} data-type="subscription" class="gc-news-form">
                <div class="sib-input sib-form-block gc-news-field">
                  <input
                    class="input gc-news-input"
                    type="email"
                    id="EMAIL"
                    name="EMAIL"
                    autocomplete="email"
                    placeholder={emailPlaceholder}
                    aria-label={emailPlaceholder}
                    data-required="true"
                    required
                  />
                  <input type="hidden" id="ORIGINE" name="ORIGINE" value="footer_groovecaviar_com" />
                  <label class="entry__error entry__error--primary gc-news-error"></label>
                </div>

                <button class="sib-form-block__button sib-form-block__button-with-loader gc-news-button" form="sib-form" type="submit">
                  {subscribeLabel}
                </button>

                <!-- Anti-spam (honeypot) : ne pas remplir -->
                <input type="text" name="email_address_check" value="" class="input--hidden" tabindex="-1" aria-hidden="true" />
                <!-- Langue de l'inscrit : fr sur les pages FR, en sur les pages EN -->
                <input type="hidden" name="locale" value={locale} />
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="gc-footer-bottom">
      <p>© {year} GROOVE CAVIAR. {rights}</p>
      <nav class="gc-footer-legal" aria-label={p('Liens légaux', 'Legal links')}>
        {legalLinks.map((item) => (
          <a href={item.href} class="gc-footer-legal-link">{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
<script is:inline set:html={brevoConfig} />
<script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>

<style>
  .gc-footer {
    background-color: #0a0a0a;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.7);
  }
  .gc-footer-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 1.25rem 2.5rem;
  }
  @media (min-width: 1024px) {
    .gc-footer-inner {
      padding-inline: 2rem;
    }
  }

  /* Grille : 1 colonne en mobile, 3 colonnes dès le bureau */
  .gc-footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .gc-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .gc-footer-grid {
      grid-template-columns: 1.4fr 1fr 1.4fr;
      gap: 4rem;
    }
  }

  /* Colonne 1 : marque */
  .gc-footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .gc-footer-logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }
  .gc-footer-wordmark {
    font-family: var(--aw-font-heading, sans-serif);
    line-height: 1;
    white-space: nowrap;
    font-size: 1.4rem;
  }
  .gc-footer-tagline {
    margin-top: 1.25rem;
    max-width: 22rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
  }
  .gc-footer-nap {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-style: normal;
  }
  .gc-footer-napline {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  .gc-footer-napline:hover {
    color: #af9453;
  }

  /* Titres de colonne */
  .gc-footer-title {
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #af9453;
    margin-bottom: 1.25rem;
  }
  .gc-footer-title--news {
    margin-top: 2.25rem;
  }

  /* Colonne 2 : liens */
  .gc-footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .gc-footer-link {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  .gc-footer-link:hover {
    color: #af9453;
  }

  /* Réseaux sociaux */
  .gc-footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .gc-footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .gc-footer-social svg {
    width: 18px;
    height: 18px;
  }
  .gc-footer-social:hover {
    color: #0d0d0d;
    background-color: #af9453;
    border-color: #af9453;
  }

  /* Newsletter */
  .gc-footer-news-intro {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 1rem;
    max-width: 24rem;
  }
  .gc-news-form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 24rem;
  }
  .gc-news-field {
    display: flex;
    flex-direction: column;
  }
  .gc-news-input {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 0.7rem 0.9rem;
    font-size: 0.95rem;
    color: #fff;
    transition: border-color 0.2s ease;
  }
  .gc-news-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  .gc-news-input:focus {
    outline: none;
    border-color: #af9453;
  }
  .gc-news-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background-color: #af9453;
    color: #0d0d0d;
    border: 0;
    border-radius: 6px;
    padding: 0.7rem 1rem;
    font-family: var(--aw-font-heading, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background-color 0.25s ease;
  }
  .gc-news-button:hover {
    background-color: #8a7440;
  }
  .gc-news-error {
    display: block;
    color: #ff8a8a;
    font-size: 0.8rem;
  }
  .gc-news-error:empty {
    display: none;
  }

  /* Panneaux de message Brevo : cachés par défaut, affichés par main.js */
  .sib-form-message-panel {
    display: none;
    border-radius: 6px;
    padding: 0.7rem 0.9rem;
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
    max-width: 24rem;
  }
  .gc-news-msg--success {
    background-color: rgba(19, 206, 102, 0.12);
    border: 1px solid #13ce66;
    color: #8ff0bb;
  }
  .gc-news-msg--error {
    background-color: rgba(255, 73, 73, 0.12);
    border: 1px solid #ff4949;
    color: #ff9a9a;
  }

  /* Honeypot anti-spam */
  .input--hidden {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Bas de footer */
  .gc-footer-bottom {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
  }
  @media (min-width: 768px) {
    .gc-footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .gc-footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .gc-footer-legal-link {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s ease;
  }
  .gc-footer-legal-link:hover {
    color: #af9453;
  }
</style>
