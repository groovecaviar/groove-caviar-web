---
import PageLayout from '~/layouts/PageLayout.astro';
import MusicSections from '~/components/sections/MusicSections.astro';
import { music } from '~/data/pages/music';

const locale = 'en';
const metadata = {
  title: 'Music — mixes & wedding playlists | Groove Caviar Biarritz',
  description:
    'Listen to Groove Caviar mixes and discover our Spotify playlists for your wedding: church, ceremony, dinner, first dances and hits by decade.',
};
---

<PageLayout metadata={metadata} lang={locale}>
  <MusicSections t={music[locale]} locale={locale} />
</PageLayout>
