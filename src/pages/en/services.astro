---
import PageLayout from '~/layouts/PageLayout.astro';
import ServicesSections from '~/components/sections/ServicesSections.astro';
import { services } from '~/data/pages/services';

const locale = 'en';
const metadata = {
  title: 'Services — DJ & music curation | Groove Caviar Biarritz',
  description:
    'Musical & technical expertise in service of emotion. Discover the bespoke services of Groove Caviar in Biarritz: DJ, speaker, sound & lighting, sound design, production.',
};
---

<PageLayout metadata={metadata} lang={locale}>
  <ServicesSections t={services[locale]} locale={locale} />
</PageLayout>
