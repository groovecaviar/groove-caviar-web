---
import PageLayout from '~/layouts/PageLayout.astro';
import EvenementsSections from '~/components/sections/EvenementsSections.astro';
import { evenements } from '~/data/pages/evenements';

// Textes de la page : src/data/textes/evenements.en.yaml
const locale = 'en';
const t = evenements[locale];
const metadata = { title: t.seo.titre, ignoreTitleTemplate: true, description: t.seo.description };
---

<PageLayout metadata={metadata} lang={locale}>
  <EvenementsSections t={t} locale={locale} />
</PageLayout>
