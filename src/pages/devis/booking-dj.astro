---
import PageLayout from '~/layouts/PageLayout.astro';
import QuoteFormSections from '~/components/sections/QuoteFormSections.astro';
import { quote } from '~/data/pages/devis';

const locale = 'fr';
const t = quote[locale].booking;
const metadata = {
  title: t.meta.title,
  description: t.meta.description,
};
---

<PageLayout metadata={metadata} lang={locale}>
  <QuoteFormSections t={t} ui={quote[locale].ui} locale={locale} />
</PageLayout>
